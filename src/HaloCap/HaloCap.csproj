<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.18362.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>HaloCap</AssemblyName>
    <RootNamespace>HaloCap</RootNamespace>
    <Product>HaloCap 光圈</Product>
    <AssemblyTitle>HaloCap 光圈</AssemblyTitle>
    <Description>在光标处呼出光圈菜单的 Windows 效率工具</Description>
    <Version>1.4.0</Version>
    <FileVersion>1.4.0</FileVersion>
    <InformationalVersion>1.4.0</InformationalVersion>
    <NeutralLanguage>zh-CN</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="RapidOcrNet" Version="4.2.0" ExcludeAssets="build" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\OcrModel\ppocrv6_tiny_det.onnx"
                      LogicalName="HaloCap.OcrModel.det.onnx" />
    <EmbeddedResource Include="Assets\OcrModel\ppocrv5_textline_cls.onnx"
                      LogicalName="HaloCap.OcrModel.cls.onnx" />
    <EmbeddedResource Include="Assets\OcrModel\ppocrv6_tiny_rec.onnx"
                      LogicalName="HaloCap.OcrModel.rec.onnx" />
    <EmbeddedResource Include="Assets\OcrModel\ppocrv6_tiny_dict.txt"
                      LogicalName="HaloCap.OcrModel.dict.txt" />
  </ItemGroup>

  <Target Name="RemoveOnnxRuntimeImportLibraries" AfterTargets="Publish">
    <Delete Files="$(PublishDir)onnxruntime.lib;$(PublishDir)onnxruntime_providers_shared.lib" />
  </Target>

</Project>
