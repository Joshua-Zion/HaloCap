<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.18362.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>HaloCap</AssemblyName>
    <RootNamespace>HaloCap</RootNamespace>
    <Product>HaloCap 光圈</Product>
    <AssemblyTitle>HaloCap 光圈</AssemblyTitle>
    <Description>在光标处呼出圆盘菜单的 Windows 效率工具</Description>
    <Version>1.1.8</Version>
    <FileVersion>1.1.8</FileVersion>
    <InformationalVersion>1.1.8</InformationalVersion>
    <NeutralLanguage>zh-CN</NeutralLanguage>
  </PropertyGroup>

</Project>
