<Window x:Class="HaloCap.UI.OcrResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HaloCap OCR"
        Width="480"
        SizeToContent="Height"
        MaxHeight="620"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        Topmost="True"
        Opacity="0"
        FontFamily="{StaticResource AppFont}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="LineButtonStyle" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Host"
                                Background="Transparent"
                                CornerRadius="8"
                                Padding="10,8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Host" Property="Background" Value="#12FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Host" Property="Background" Value="#0AFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root" Margin="18" Focusable="True">
        <Border CornerRadius="17" Background="#FF151922">
            <Border.Effect>
                <DropShadowEffect Color="#FF000000" BlurRadius="32" ShadowDepth="8" Opacity="0.55" />
            </Border.Effect>
        </Border>

        <Border CornerRadius="17"
                Background="{StaticResource WindowBackgroundBrush}"
                BorderBrush="#26FFFFFF"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid x:Name="TitleBar"
                      Grid.Row="0"
                      Height="66"
                      Margin="20,0,12,0"
                      Background="Transparent"
                      MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Width="32" Height="32" VerticalAlignment="Center">
                        <Border CornerRadius="10" Background="#2BB08CFF" BorderBrush="#66B08CFF" BorderThickness="1" />
                        <TextBlock Text="文"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#FFCBB7FF"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="OCR 识别结果"
                                   FontSize="14.5"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="Windows.Media.Ocr · 完全离线"
                                   FontSize="10.5"
                                   Foreground="{StaticResource TextTertiaryBrush}"
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <Button Grid.Column="2"
                            Style="{StaticResource CloseButtonStyle}"
                            Content="✕"
                            FontFamily="Segoe UI"
                            ToolTip="关闭"
                            AutomationProperties.Name="关闭 OCR 结果"
                            Click="CloseButton_Click" />
                </Grid>

                <Grid Grid.Row="1" Margin="20,0,20,10">
                    <Border HorizontalAlignment="Left"
                            Padding="9,4"
                            CornerRadius="6"
                            Background="#20B08CFF"
                            BorderBrush="#33B08CFF"
                            BorderThickness="1">
                        <TextBlock x:Name="LanguageText"
                                   Text="—"
                                   FontSize="10.5"
                                   Foreground="#FFD3C0FF" />
                    </Border>

                    <TextBlock x:Name="CountText"
                               Text=""
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               FontSize="10.5"
                               Foreground="{StaticResource TextTertiaryBrush}" />
                </Grid>

                <Border x:Name="WarningBorder"
                        Grid.Row="2"
                        Margin="20,0,20,4"
                        Padding="12,10"
                        CornerRadius="9"
                        Background="#1FF5B963"
                        BorderBrush="#33F5B963"
                        BorderThickness="1"
                        Visibility="Collapsed">
                    <TextBlock x:Name="WarningText"
                               FontSize="11"
                               Foreground="#FFE4C38C"
                               TextWrapping="Wrap"
                               LineHeight="17" />
                </Border>

                <StackPanel Grid.Row="3" Margin="20,0,20,0">
                    <StackPanel x:Name="LoadingPanel"
                                Orientation="Vertical"
                                HorizontalAlignment="Center"
                                Margin="0,26,0,34">
                        <ProgressBar IsIndeterminate="True"
                                     Width="170"
                                     Height="3"
                                     Foreground="#FFB08CFF"
                                     Background="#1FFFFFFF"
                                     BorderThickness="0" />
                        <TextBlock Text="正在识别文字…"
                                   FontSize="11.5"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,13,0,0"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <ScrollViewer x:Name="LinesScroll"
                                  MaxHeight="330"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Visibility="Collapsed"
                                  Margin="0,2,0,4">
                        <StackPanel x:Name="LinesPanel" />
                    </ScrollViewer>

                    <TextBlock x:Name="EmptyText"
                               Visibility="Collapsed"
                               FontSize="11.5"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               LineHeight="18"
                               Margin="2,16,2,22" />
                </StackPanel>

                <Grid Grid.Row="4" Margin="20,14,20,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="StatusText"
                               Text="Esc 关闭 · 点击任意一行可复制"
                               FontSize="10.5"
                               Foreground="{StaticResource TextTertiaryBrush}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,0,12,0" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="关闭"
                                Width="76"
                                Height="34"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="CloseButton_Click" />
                        <Button x:Name="CopyAllButton"
                                Content="复制全部"
                                Width="98"
                                Height="34"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Margin="9,0,0,0"
                                IsEnabled="False"
                                Click="CopyAllButton_Click" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
