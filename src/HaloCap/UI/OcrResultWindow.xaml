<Window x:Class="HaloCap.UI.OcrResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HaloCap 文字识别"
        Width="480"
        SizeToContent="Height"
        MaxHeight="620"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FocusVisualStyle="{x:Null}"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        Topmost="True"
        Opacity="0"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="OcrTextPrimaryBrush" Color="#FF1D1D1F" />
        <SolidColorBrush x:Key="OcrTextSecondaryBrush" Color="#FF6E6E73" />
        <SolidColorBrush x:Key="OcrTextTertiaryBrush" Color="#FF8E8E93" />
        <SolidColorBrush x:Key="OcrAccentBrush" Color="#FF007AFF" />
        <SolidColorBrush x:Key="OcrDangerBrush" Color="#FFD70015" />
        <SolidColorBrush x:Key="OcrWarningTextBrush" Color="#FF8A6116" />
        <SolidColorBrush x:Key="OcrWarningFillBrush" Color="#FFFFF8E8" />
        <SolidColorBrush x:Key="OcrWarningBorderBrush" Color="#FFF0E1B9" />
        <SolidColorBrush x:Key="OcrChipFillBrush" Color="#FFEDF5FF" />
        <SolidColorBrush x:Key="OcrChipBorderBrush" Color="#FFD8E9FF" />
        <SolidColorBrush x:Key="OcrChipTextBrush" Color="#FF0068D9" />
        <SolidColorBrush x:Key="OcrHairlineBrush" Color="#14000000" />

        <Style x:Key="LineButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Host"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10,7"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Host" Property="Background" Value="#FFFFFFFF" />
                                <Setter TargetName="Host" Property="BorderBrush" Value="#FFE7E7EC" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Host" Property="Background" Value="#FFF2F7FF" />
                                <Setter TargetName="Host" Property="BorderBrush" Value="#FFDCE9FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OcrCloseButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{StaticResource OcrTextTertiaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Host" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Host" Property="Background" Value="#FFF0F0F3" />
                                <Setter Property="Foreground" Value="{StaticResource OcrTextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Host" Property="Background" Value="#FFE7E7EB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OcrSecondaryButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{StaticResource OcrTextPrimaryBrush}" />
            <Setter Property="Background" Value="#FFFFFFFF" />
            <Setter Property="BorderBrush" Value="#FFD6D6DB" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Host"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Host" Property="Background" Value="#FFF7F7FA" />
                                <Setter TargetName="Host" Property="BorderBrush" Value="#FFC9C9CF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Host" Property="Background" Value="#FFEFEFF2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OcrPrimaryButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="#FFFFFFFF" />
            <Setter Property="Background" Value="{StaticResource OcrAccentBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="20,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Host"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Host" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Host" Property="Opacity" Value="0.78" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Host" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                                  Opacity="0"
                                                  Focusable="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb MinHeight="28" Width="6" HorizontalAlignment="Center">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#38000000" CornerRadius="3" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                                  Opacity="0"
                                                  Focusable="False" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root" Margin="18" Focusable="True" FocusVisualStyle="{x:Null}">
        <Border CornerRadius="17" Background="#FFFFFFFF">
            <Border.Effect>
                <DropShadowEffect Color="#FF000000" BlurRadius="28" ShadowDepth="8" Opacity="0.26" />
            </Border.Effect>
        </Border>

        <Border CornerRadius="17"
                Background="#FFFFFFFF"
                BorderBrush="#24000000"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid x:Name="TitleBar"
                      Grid.Row="0"
                      Height="64"
                      Margin="20,0,14,0"
                      Background="Transparent"
                      MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="32"
                            Height="32"
                            CornerRadius="9"
                            Background="#FFEAF3FF"
                            BorderBrush="#FFD4E7FF"
                            BorderThickness="1"
                            VerticalAlignment="Center">
                        <TextBlock Text="文"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource OcrAccentBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="文字识别结果"
                                   FontSize="14.5"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource OcrTextPrimaryBrush}" />
                        <TextBlock Text="Windows 离线引擎 · 无网络请求"
                                   FontSize="10.5"
                                   Foreground="{StaticResource OcrTextTertiaryBrush}"
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <Button Grid.Column="2"
                            Style="{StaticResource OcrCloseButtonStyle}"
                            Content="✕"
                            FontFamily="Segoe UI"
                            ToolTip="关闭"
                            AutomationProperties.Name="关闭文字识别结果"
                            Click="CloseButton_Click" />
                </Grid>

                <Grid Grid.Row="1" Margin="20,0,20,12">
                    <Border x:Name="LanguageChip"
                            Visibility="Collapsed"
                            HorizontalAlignment="Left"
                            Padding="9,3"
                            CornerRadius="6"
                            Background="{StaticResource OcrChipFillBrush}"
                            BorderBrush="{StaticResource OcrChipBorderBrush}"
                            BorderThickness="1">
                        <TextBlock x:Name="LanguageText"
                                   Text="—"
                                   FontSize="10.5"
                                   Foreground="{StaticResource OcrChipTextBrush}" />
                    </Border>

                    <TextBlock x:Name="CountText"
                               Text=""
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               FontSize="10.5"
                               Foreground="{StaticResource OcrTextTertiaryBrush}" />
                </Grid>

                <Border x:Name="WarningBorder"
                        Grid.Row="2"
                        Margin="20,0,20,6"
                        Padding="12,10"
                        CornerRadius="9"
                        Background="{StaticResource OcrWarningFillBrush}"
                        BorderBrush="{StaticResource OcrWarningBorderBrush}"
                        BorderThickness="1"
                        Visibility="Collapsed">
                    <TextBlock x:Name="WarningText"
                               FontSize="11"
                               Foreground="{StaticResource OcrWarningTextBrush}"
                               TextWrapping="Wrap"
                               LineHeight="17" />
                </Border>

                <StackPanel Grid.Row="3" Margin="20,0,20,0">
                    <StackPanel x:Name="LoadingPanel"
                                Orientation="Vertical"
                                HorizontalAlignment="Center"
                                Margin="0,22,0,30">
                        <ProgressBar IsIndeterminate="True"
                                     Width="170"
                                     Height="3"
                                     Foreground="{StaticResource OcrAccentBrush}"
                                     Background="#FFE8E8ED"
                                     BorderThickness="0" />
                        <TextBlock Text="正在识别文字…"
                                   FontSize="11.5"
                                   Foreground="{StaticResource OcrTextSecondaryBrush}"
                                   Margin="0,13,0,0"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <Border x:Name="LinesCard"
                            Visibility="Collapsed"
                            Background="#FFF7F7F9"
                            BorderBrush="#FFECECEF"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="4,6"
                            Margin="0,0,0,4">
                        <ScrollViewer x:Name="LinesScroll"
                                      MaxHeight="330"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="LinesPanel" />
                        </ScrollViewer>
                    </Border>

                    <TextBlock x:Name="EmptyText"
                               Visibility="Collapsed"
                               FontSize="11.5"
                               Foreground="{StaticResource OcrTextSecondaryBrush}"
                               TextWrapping="Wrap"
                               LineHeight="18"
                               Margin="2,10,2,18" />
                </StackPanel>

                <Border Grid.Row="4"
                        Margin="0,12,0,0"
                        BorderBrush="{StaticResource OcrHairlineBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="20,12,20,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="StatusText"
                                   Text="Esc 关闭"
                                   FontSize="10.5"
                                   Foreground="{StaticResource OcrTextTertiaryBrush}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,0,12,0" />

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="关闭"
                                    Width="72"
                                    Style="{StaticResource OcrSecondaryButtonStyle}"
                                    Click="CloseButton_Click" />
                            <Button x:Name="CopyAllButton"
                                    Content="复制全部"
                                    Width="94"
                                    Style="{StaticResource OcrPrimaryButtonStyle}"
                                    Margin="9,0,0,0"
                                    IsEnabled="False"
                                    Click="CopyAllButton_Click" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
