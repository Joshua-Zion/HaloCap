<Window x:Class="HaloCap.UI.OcrResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HaloCap 文字识别"
        Width="560"
        SizeToContent="Height"
        MaxHeight="660"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FocusVisualStyle="{x:Null}"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        Topmost="True"
        Opacity="0"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="OcrTextPrimaryBrush" Color="#FF1D1D1F" />
        <SolidColorBrush x:Key="OcrTextSecondaryBrush" Color="#FF6E6E73" />
        <SolidColorBrush x:Key="OcrTextTertiaryBrush" Color="#FF8E8E93" />
        <SolidColorBrush x:Key="OcrAccentBrush" Color="#FF007AFF" />
        <SolidColorBrush x:Key="OcrDangerBrush" Color="#FFD70015" />
        <SolidColorBrush x:Key="OcrWarningTextBrush" Color="#FF8A6116" />
        <SolidColorBrush x:Key="OcrWarningFillBrush" Color="#FFFFF8E8" />
        <SolidColorBrush x:Key="OcrWarningBorderBrush" Color="#FFF0E1B9" />
        <SolidColorBrush x:Key="OcrChipFillBrush" Color="#FFEDF5FF" />
        <SolidColorBrush x:Key="OcrChipBorderBrush" Color="#FFD8E9FF" />
        <SolidColorBrush x:Key="OcrChipTextBrush" Color="#FF0068D9" />
        <SolidColorBrush x:Key="OcrHairlineBrush" Color="#14000000" />

        <Style x:Key="LineButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Host"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10,6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Host" Property="Background" Value="#FFFFFFFF" />
                                <Setter TargetName="Host" Property="BorderBrush" Value="#FFE7E7EC" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Host" Property="Background" Value="#FFF2F7FF" />
                                <Setter TargetName="Host" Property="BorderBrush" Value="#FFDCE9FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OcrCloseButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{StaticResource OcrTextTertiaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Host" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Host" Property="Background" Value="#FFF0F0F3" />
                                <Setter Property="Foreground" Value="{StaticResource OcrTextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Host" Property="Background" Value="#FFE7E7EB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OcrSecondaryButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{StaticResource OcrTextPrimaryBrush}" />
            <Setter Property="Background" Value="#FFFFFFFF" />
            <Setter Property="BorderBrush" Value="#FFD6D6DB" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Host"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Host" Property="Background" Value="#FFF7F7FA" />
                                <Setter TargetName="Host" Property="BorderBrush" Value="#FFC9C9CF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Host" Property="Background" Value="#FFEFEFF2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OcrSmallButtonStyle" TargetType="Button" BasedOn="{StaticResource OcrSecondaryButtonStyle}">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="BorderBrush" Value="#FFE1E1E6" />
        </Style>

        <Style x:Key="OcrToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{StaticResource OcrTextPrimaryBrush}" />
            <Setter Property="Background" Value="#FFFFFFFF" />
            <Setter Property="BorderBrush" Value="#FFD6D6DB" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="15,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Host"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Host" Property="Background" Value="#FFF7F7FA" />
                                <Setter TargetName="Host" Property="BorderBrush" Value="#FFC9C9CF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Host" Property="Background" Value="#FFEDF5FF" />
                                <Setter TargetName="Host" Property="BorderBrush" Value="#FFD8E9FF" />
                                <Setter Property="Foreground" Value="{StaticResource OcrChipTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OcrPrimaryButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="#FFFFFFFF" />
            <Setter Property="Background" Value="{StaticResource OcrAccentBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="20,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Host"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Host" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Host" Property="Opacity" Value="0.78" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Host" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OcrModeOptionStyle" TargetType="RadioButton">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Width" Value="80" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource OcrTextSecondaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Host"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Host" Property="Background" Value="#FFEBEBEF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Host" Property="Background" Value="#FFFFFFFF" />
                                <Setter TargetName="Host" Property="BorderBrush" Value="#FFDCDCE1" />
                                <Setter Property="Foreground" Value="{StaticResource OcrTextPrimaryBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OcrSearchBoxStyle" TargetType="TextBox">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Background" Value="#FFFFFFFF" />
            <Setter Property="Foreground" Value="{StaticResource OcrTextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="#FFDCDCE1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="CaretBrush" Value="{StaticResource OcrAccentBrush}" />
            <Setter Property="SelectionBrush" Value="#4D007AFF" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          VerticalScrollBarVisibility="Hidden" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource OcrAccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                                  Opacity="0"
                                                  Focusable="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb MinHeight="28" Width="6" HorizontalAlignment="Center">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#38000000" CornerRadius="3" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                                  Opacity="0"
                                                  Focusable="False" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root" Margin="18" Focusable="True" FocusVisualStyle="{x:Null}">
        <Border CornerRadius="17" Background="#FFFFFFFF">
            <Border.Effect>
                <DropShadowEffect Color="#FF000000" BlurRadius="28" ShadowDepth="8" Opacity="0.26" />
            </Border.Effect>
        </Border>

        <Border CornerRadius="17"
                Background="#FFFFFFFF"
                BorderBrush="#24000000"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid x:Name="TitleBar"
                      Grid.Row="0"
                      Height="58"
                      Margin="20,0,14,0"
                      Background="Transparent"
                      MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="32"
                            Height="32"
                            CornerRadius="9"
                            Background="#FFEAF3FF"
                            BorderBrush="#FFD4E7FF"
                            BorderThickness="1"
                            VerticalAlignment="Center">
                        <TextBlock Text="文"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource OcrAccentBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="文字识别结果"
                                   FontSize="14.5"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource OcrTextPrimaryBrush}" />
                        <TextBlock x:Name="SubtitleText"
                                   Text="按行识别 · 完全离线"
                                   FontSize="10.5"
                                   Foreground="{StaticResource OcrTextTertiaryBrush}"
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <Button Grid.Column="2"
                            Style="{StaticResource OcrCloseButtonStyle}"
                            Content="✕"
                            FontFamily="Segoe UI"
                            ToolTip="关闭"
                            AutomationProperties.Name="关闭文字识别结果"
                            Click="CloseButton_Click" />
                </Grid>

                <Grid Grid.Row="1" Margin="20,0,20,9">
                    <Border x:Name="EngineChip"
                            Visibility="Collapsed"
                            HorizontalAlignment="Left"
                            Padding="9,3"
                            CornerRadius="6"
                            Background="{StaticResource OcrChipFillBrush}"
                            BorderBrush="{StaticResource OcrChipBorderBrush}"
                            BorderThickness="1">
                        <TextBlock x:Name="EngineText"
                                   Text="—"
                                   FontSize="10.5"
                                   Foreground="{StaticResource OcrChipTextBrush}" />
                    </Border>

                    <TextBlock x:Name="CountText"
                               Text=""
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               FontSize="10.5"
                               Foreground="{StaticResource OcrTextTertiaryBrush}" />
                </Grid>

                <Grid Grid.Row="2" Margin="20,0,20,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Background="#FFF0F0F3"
                            BorderBrush="#FFE2E2E7"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="2"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="NativeEngineRadio"
                                         GroupName="OcrEngine"
                                         Tag="Native"
                                         Content="原生识别"
                                         ToolTip="Windows 自带引擎，速度快、占用低"
                                         Style="{StaticResource OcrModeOptionStyle}"
                                         Checked="ModeRadio_Checked"
                                         AutomationProperties.Name="原生识别" />
                            <RadioButton x:Name="ModelEngineRadio"
                                         GroupName="OcrEngine"
                                         Tag="Model"
                                         Content="模型识别"
                                         ToolTip="内置 PP-OCRv6 tiny 轻量模型，中英混排更稳，速度稍慢"
                                         Style="{StaticResource OcrModeOptionStyle}"
                                         Checked="ModeRadio_Checked"
                                         AutomationProperties.Name="模型识别" />
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button x:Name="SearchButton"
                                Content="搜索"
                                Style="{StaticResource OcrSmallButtonStyle}"
                                ToolTip="搜索识别结果 (Ctrl+F)"
                                AutomationProperties.Name="搜索文字"
                                Click="SearchButton_Click" />
                        <Button x:Name="ViewToggleButton"
                                Content="逐行"
                                Style="{StaticResource OcrSmallButtonStyle}"
                                Margin="6,0,0,0"
                                ToolTip="切换到逐行复制"
                                AutomationProperties.Name="切换结果视图"
                                Click="ViewToggleButton_Click" />
                    </StackPanel>
                </Grid>

                <Border x:Name="SearchBar"
                        Grid.Row="3"
                        Margin="20,0,20,10"
                        Padding="10,8"
                        CornerRadius="9"
                        Background="#FFF7F7F9"
                        BorderBrush="#FFECECEF"
                        BorderThickness="1"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid>
                            <TextBox x:Name="SearchBox"
                                     Style="{StaticResource OcrSearchBoxStyle}"
                                     AutomationProperties.Name="搜索识别结果"
                                     TextChanged="SearchBox_TextChanged"
                                     PreviewKeyDown="SearchBox_PreviewKeyDown" />
                            <TextBlock x:Name="SearchPlaceholder"
                                       Text="搜索识别结果"
                                       FontSize="11.5"
                                       Foreground="{StaticResource OcrTextTertiaryBrush}"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False" />
                        </Grid>

                        <TextBlock x:Name="SearchStatusText"
                                   Grid.Column="1"
                                   FontSize="10.5"
                                   Foreground="{StaticResource OcrTextTertiaryBrush}"
                                   Margin="10,0,8,0"
                                   VerticalAlignment="Center"
                                   MinWidth="48"
                                   TextAlignment="Right" />

                        <Button Grid.Column="2"
                                Content="上一处"
                                Style="{StaticResource OcrSmallButtonStyle}"
                                Padding="9,0"
                                Click="SearchPreviousButton_Click" />
                        <Button Grid.Column="3"
                                Content="下一处"
                                Style="{StaticResource OcrSmallButtonStyle}"
                                Padding="9,0"
                                Margin="6,0,0,0"
                                Click="SearchNextButton_Click" />
                        <Button Grid.Column="4"
                                Content="✕"
                                Style="{StaticResource OcrCloseButtonStyle}"
                                ToolTip="关闭搜索 (Esc)"
                                Margin="4,0,0,0"
                                Click="CloseSearchButton_Click" />
                    </Grid>
                </Border>

                <Border x:Name="WarningBorder"
                        Grid.Row="4"
                        Margin="20,0,20,8"
                        Padding="12,10"
                        CornerRadius="9"
                        Background="{StaticResource OcrWarningFillBrush}"
                        BorderBrush="{StaticResource OcrWarningBorderBrush}"
                        BorderThickness="1"
                        Visibility="Collapsed">
                    <ScrollViewer MaxHeight="70" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <TextBlock x:Name="WarningText"
                                   FontSize="11"
                                   Foreground="{StaticResource OcrWarningTextBrush}"
                                   TextWrapping="Wrap"
                                   LineHeight="17" />
                    </ScrollViewer>
                </Border>

                <StackPanel Grid.Row="5" Margin="20,0,20,0">
                    <Border x:Name="LoadingPanel"
                            Background="#FFF7F7F9"
                            BorderBrush="#FFECECEF"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="0,22,0,20"
                            Margin="0,0,0,4">
                        <StackPanel Orientation="Vertical"
                                    HorizontalAlignment="Center">
                            <ProgressBar IsIndeterminate="True"
                                         Width="180"
                                         Height="3"
                                         Foreground="{StaticResource OcrAccentBrush}"
                                         Background="#FFE8E8ED"
                                         BorderThickness="0" />
                            <TextBlock Text="正在识别文字…"
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource OcrTextSecondaryBrush}"
                                       Margin="0,13,0,0"
                                       HorizontalAlignment="Center" />
                            <TextBlock x:Name="LoadingHintText"
                                       Text=""
                                       FontSize="10.5"
                                       Foreground="{StaticResource OcrTextTertiaryBrush}"
                                       Margin="0,4,0,0"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="TextCard"
                            Visibility="Collapsed"
                            Background="#FFF7F7F9"
                            BorderBrush="#FFECECEF"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="2"
                            Margin="0,0,0,4">
                        <TextBox x:Name="ResultTextBox"
                                 IsReadOnly="True"
                                 IsReadOnlyCaretVisible="True"
                                 IsInactiveSelectionHighlightEnabled="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Foreground="{StaticResource OcrTextPrimaryBrush}"
                                 FontFamily="Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI"
                                 FontSize="13"
                                 TextBlock.LineHeight="21"
                                 Padding="12,10"
                                 MinHeight="96"
                                 MaxHeight="220"
                                 VerticalContentAlignment="Top"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Disabled"
                                 SpellCheck.IsEnabled="False"
                                 AutomationProperties.Name="识别文本" />
                    </Border>

                    <Border x:Name="LinesCard"
                            Visibility="Collapsed"
                            Background="#FFF7F7F9"
                            BorderBrush="#FFECECEF"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="4,6"
                            Margin="0,0,0,4">
                        <ScrollViewer x:Name="LinesScroll"
                                      MaxHeight="220"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="LinesPanel" />
                        </ScrollViewer>
                    </Border>

                    <StackPanel x:Name="EmptyState"
                                Visibility="Collapsed"
                                HorizontalAlignment="Center"
                                Margin="0,14,0,18">
                        <Border x:Name="EmptyStateIcon"
                                Width="46"
                                Height="46"
                                CornerRadius="14"
                                Background="{StaticResource OcrChipFillBrush}"
                                BorderBrush="{StaticResource OcrChipBorderBrush}"
                                BorderThickness="1"
                                HorizontalAlignment="Center">
                            <TextBlock x:Name="EmptyStateGlyph"
                                       Text="文"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource OcrChipTextBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Name="EmptyText"
                                   MaxWidth="430"
                                   FontSize="12"
                                   Foreground="{StaticResource OcrTextSecondaryBrush}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   LineHeight="19"
                                   Margin="0,12,0,0" />
                        <Button x:Name="EmptyRetryButton"
                                Visibility="Collapsed"
                                Content="重新识别"
                                MinWidth="132"
                                Height="34"
                                Margin="0,12,0,0"
                                HorizontalAlignment="Center"
                                Style="{StaticResource OcrSecondaryButtonStyle}"
                                Click="EmptyRetryButton_Click" />
                    </StackPanel>

                    <Border x:Name="ThumbnailCard"
                            Visibility="Collapsed"
                            Background="#FFF7F7F9"
                            BorderBrush="#FFECECEF"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="6"
                            Margin="0,4,0,4">
                        <Image x:Name="ThumbnailImage"
                               MaxHeight="80"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               ToolTip="原图缩略图" />
                    </Border>
                </StackPanel>

                <Border Grid.Row="6"
                        Margin="0,10,0,0"
                        BorderBrush="{StaticResource OcrHairlineBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="20,12,20,15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="StatusText"
                                   Text="Esc 关闭 · 可选择文本"
                                   FontSize="10.5"
                                   Foreground="{StaticResource OcrTextTertiaryBrush}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,0,12,0" />

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="RetryButton"
                                    Content="重试"
                                    Width="62"
                                    Style="{StaticResource OcrSecondaryButtonStyle}"
                                    ToolTip="用当前引擎重新识别"
                                    AutomationProperties.Name="重新识别"
                                    IsEnabled="False"
                                    Click="RetryButton_Click" />
                            <ToggleButton x:Name="ThumbnailButton"
                                          Content="原图"
                                          Style="{StaticResource OcrToggleButtonStyle}"
                                          ToolTip="显示原图缩略图"
                                          AutomationProperties.Name="显示原图"
                                          Margin="8,0,0,0"
                                          Checked="ThumbnailButton_Changed"
                                          Unchecked="ThumbnailButton_Changed" />
                            <Button Content="关闭"
                                    Width="72"
                                    Style="{StaticResource OcrSecondaryButtonStyle}"
                                    Margin="8,0,0,0"
                                    Click="CloseButton_Click" />
                            <Button x:Name="CopyAllButton"
                                    Content="复制全部"
                                    Width="94"
                                    Style="{StaticResource OcrPrimaryButtonStyle}"
                                    Margin="9,0,0,0"
                                    IsEnabled="False"
                                    Click="CopyAllButton_Click" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
