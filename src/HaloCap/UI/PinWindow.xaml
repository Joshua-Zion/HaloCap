<Window x:Class="HaloCap.UI.PinWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HaloCap.UI"
        Title="HaloCap 贴图"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="True"
        Background="Transparent"
        SnapsToDevicePixels="True"
        FontFamily="{StaticResource AppFont}"
        Cursor="SizeAll"
        PreviewKeyDown="Window_PreviewKeyDown"
        MouseWheel="Window_MouseWheel">
    <Window.Resources>
        <Style x:Key="PinMenuStyle" TargetType="ContextMenu">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="#F2171C25"
                                BorderBrush="#33FFFFFF"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="6">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PinMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="#E7EDF6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Host"
                                Background="Transparent"
                                CornerRadius="6"
                                Padding="12,7">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="{TemplateBinding InputGestureText}"
                                           Foreground="#7D8797"
                                           FontSize="10.5"
                                           Margin="20,0,0,0"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Host" Property="Background" Value="#1CFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PinSeparatorStyle" TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="#1FFFFFFF" Margin="8,5" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PinToolButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#3C4250" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Host"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Host" Property="Background" Value="#14000000" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.32" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PinOptionButtonStyle" TargetType="Button" BasedOn="{StaticResource PinToolButtonStyle}">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
        </Style>

        <Style x:Key="PinColorSwatchStyle" TargetType="Button">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Ring"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="2"
                                CornerRadius="12"
                                Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Background" Value="#14000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PinBarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#2A303B" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Host"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Host" Property="Background" Value="#14000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.ContextMenu>
        <ContextMenu Style="{StaticResource PinMenuStyle}">
            <MenuItem Header="标注图片"
                      InputGestureText="Space"
                      Style="{StaticResource PinMenuItemStyle}"
                      Click="AnnotateMenuItem_Click" />
            <Separator Style="{StaticResource PinSeparatorStyle}" />
            <MenuItem Header="复制图片"
                      InputGestureText="Ctrl+C"
                      Style="{StaticResource PinMenuItemStyle}"
                      Click="CopyMenuItem_Click" />
            <MenuItem Header="保存图片…"
                      InputGestureText="Ctrl+S"
                      Style="{StaticResource PinMenuItemStyle}"
                      Click="SaveMenuItem_Click" />
            <Separator Style="{StaticResource PinSeparatorStyle}" />
            <MenuItem Header="恢复初始大小"
                      InputGestureText="Ctrl+0"
                      Style="{StaticResource PinMenuItemStyle}"
                      Click="ResetMenuItem_Click" />
            <Separator Style="{StaticResource PinSeparatorStyle}" />
            <MenuItem Header="关闭此贴图"
                      InputGestureText="Esc"
                      Style="{StaticResource PinMenuItemStyle}"
                      Click="CloseMenuItem_Click" />
            <MenuItem Header="关闭全部贴图"
                      Style="{StaticResource PinMenuItemStyle}"
                      Click="CloseAllMenuItem_Click" />
        </ContextMenu>
    </Window.ContextMenu>

    <Grid x:Name="Root"
          Background="Transparent"
          Focusable="True"
          MouseLeftButtonDown="Root_MouseLeftButtonDown"
          PreviewMouseLeftButtonDown="Root_PreviewMouseLeftButtonDown"
          PreviewMouseMove="Root_PreviewMouseMove"
          PreviewMouseLeftButtonUp="Root_PreviewMouseLeftButtonUp">
        <Image x:Name="PreviewImage"
               Stretch="Fill"
               RenderOptions.BitmapScalingMode="HighQuality"
               SnapsToDevicePixels="True" />

        <local:AnnotationCanvas x:Name="AnnotationView"
                                IsHitTestVisible="False"
                                ClipToBounds="True" />

        <Border BorderBrush="#40FFFFFF"
                BorderThickness="1"
                IsHitTestVisible="False" />

        <Canvas x:Name="EditorLayer" ClipToBounds="True" />

        <Viewbox x:Name="AnnotationBarHost"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Top"
                 Margin="8"
                 Stretch="Uniform"
                 StretchDirection="DownOnly"
                 Visibility="Collapsed"
                 Panel.ZIndex="10">
            <StackPanel>
            <Border x:Name="AnnotationBar"
                    HorizontalAlignment="Center"
                    Padding="4"
                    CornerRadius="10"
                    Background="#FAF8F9FB"
                    BorderBrush="#22000000"
                    BorderThickness="1"
                    Cursor="Arrow">
                <Border.Effect>
                    <DropShadowEffect Color="#FF000000" BlurRadius="20" ShadowDepth="4" Opacity="0.24" />
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="ToolShapeButton"
                            AutomationProperties.AutomationId="tool.shape"
                            Style="{StaticResource PinToolButtonStyle}"
                            Tag="Shape"
                            ToolTip="形状 (R/E) · 在选项栏切换矩形 / 椭圆"
                            Click="AnnotationTool_Click">
                        <Viewbox Width="20" Height="20">
                            <Path Style="{StaticResource ToolbarIconStyle}" Data="{StaticResource ToolbarShapeGeometry}" />
                        </Viewbox>
                    </Button>
                    <Button x:Name="ToolArrowButton"
                            AutomationProperties.AutomationId="tool.arrow"
                            Style="{StaticResource PinToolButtonStyle}"
                            Tag="Arrow"
                            ToolTip="箭头 (A) · Shift 锁定角度"
                            Click="AnnotationTool_Click">
                        <Viewbox Width="20" Height="20">
                            <Path Style="{StaticResource ToolbarIconStyle}" Data="{StaticResource ToolbarArrowGeometry}" />
                        </Viewbox>
                    </Button>
                    <Button x:Name="ToolPenButton"
                            AutomationProperties.AutomationId="tool.pen"
                            Style="{StaticResource PinToolButtonStyle}"
                            Tag="Pen"
                            ToolTip="画笔 (P) · 滚轮调粗细"
                            Click="AnnotationTool_Click">
                        <Viewbox Width="20" Height="20">
                            <Path Style="{StaticResource ToolbarIconStyle}" Data="{StaticResource ToolbarPenGeometry}" />
                        </Viewbox>
                    </Button>
                    <Button x:Name="ToolHighlighterButton"
                            AutomationProperties.AutomationId="tool.highlighter"
                            Style="{StaticResource PinToolButtonStyle}"
                            Tag="Highlighter"
                            ToolTip="荧光笔 (H) · 滚轮调粗细"
                            Click="AnnotationTool_Click">
                        <Viewbox Width="20" Height="20">
                            <Path Style="{StaticResource ToolbarIconStyle}" Data="{StaticResource ToolbarHighlighterGeometry}" />
                        </Viewbox>
                    </Button>
                    <Button x:Name="ToolEraserButton"
                            AutomationProperties.AutomationId="tool.eraser"
                            Style="{StaticResource PinToolButtonStyle}"
                            Tag="Eraser"
                            ToolTip="橡皮擦 (X) · 滚轮调大小 · 划过删除整条标注"
                            Click="AnnotationTool_Click">
                        <Viewbox Width="20" Height="20">
                            <Path Style="{StaticResource ToolbarIconStyle}" Data="{StaticResource ToolbarEraserGeometry}" />
                        </Viewbox>
                    </Button>
                    <Button x:Name="ToolTextButton"
                            AutomationProperties.AutomationId="tool.text"
                            Style="{StaticResource PinToolButtonStyle}"
                            Tag="Text"
                            ToolTip="文字 (T) · 滚轮调字号"
                            Click="AnnotationTool_Click">
                        <Viewbox Width="20" Height="20">
                            <Path Style="{StaticResource ToolbarIconStyle}" Data="{StaticResource ToolbarTextGeometry}" />
                        </Viewbox>
                    </Button>
                    <Button x:Name="ToolMosaicButton"
                            AutomationProperties.AutomationId="tool.mosaic"
                            Style="{StaticResource PinToolButtonStyle}"
                            Tag="Mosaic"
                            ToolTip="马赛克 (M) · 滚轮调密度"
                            Click="AnnotationTool_Click">
                        <Viewbox Width="20" Height="20">
                            <Path Style="{StaticResource ToolbarIconStyle}" Data="{StaticResource ToolbarMosaicGeometry}" />
                        </Viewbox>
                    </Button>
                    <Button x:Name="ToolStepButton"
                            AutomationProperties.AutomationId="tool.step"
                            Style="{StaticResource PinToolButtonStyle}"
                            Tag="Step"
                            ToolTip="序号 (N)"
                            Click="AnnotationTool_Click">
                        <Viewbox Width="20" Height="20">
                            <Path Style="{StaticResource ToolbarIconStyle}" Data="{StaticResource ToolbarStepGeometry}" />
                        </Viewbox>
                    </Button>

                    <Border Width="1" Margin="4,6" Background="#1A000000" />

                    <Button x:Name="UndoButton"
                            AutomationProperties.AutomationId="history.undo"
                            Style="{StaticResource PinToolButtonStyle}"
                            Tag="Undo"
                            ToolTip="撤销 (Ctrl+Z)"
                            Click="AnnotationAction_Click">
                        <Viewbox Width="20" Height="20">
                            <Path Style="{StaticResource ToolbarIconStyle}" Data="{StaticResource ToolbarUndoGeometry}" />
                        </Viewbox>
                    </Button>
                    <Button x:Name="RedoButton"
                            AutomationProperties.AutomationId="history.redo"
                            Style="{StaticResource PinToolButtonStyle}"
                            Tag="Redo"
                            ToolTip="重做 (Ctrl+Y)"
                            Click="AnnotationAction_Click">
                        <Viewbox Width="20" Height="20">
                            <Path Style="{StaticResource ToolbarIconStyle}" Data="{StaticResource ToolbarRedoGeometry}" />
                        </Viewbox>
                    </Button>
                    <Button x:Name="ClearButton"
                            AutomationProperties.AutomationId="history.clear"
                            Style="{StaticResource PinToolButtonStyle}"
                            Tag="Clear"
                            ToolTip="清空标注"
                            Click="AnnotationAction_Click">
                        <Viewbox Width="20" Height="20">
                            <Path Style="{StaticResource ToolbarIconStyle}" Data="{StaticResource ToolbarClearGeometry}" />
                        </Viewbox>
                    </Button>
                    <Button Style="{StaticResource PinToolButtonStyle}"
                            AutomationProperties.AutomationId="action.done"
                            AutomationProperties.Name="完成"
                            Tag="Done"
                            Foreground="#FFFFFFFF"
                            Background="#FF2F7CF6"
                            ToolTip="完成，退出标注 (Space)"
                            Click="AnnotationAction_Click">
                        <Viewbox Width="20" Height="20">
                            <Path Style="{StaticResource ToolbarIconStyle}" Data="{StaticResource ToolbarDoneGeometry}" />
                        </Viewbox>
                    </Button>
                </StackPanel>
            </Border>

            <Border x:Name="PinOptionBar"
                    HorizontalAlignment="Center"
                    Margin="0,6,0,0"
                    Height="40"
                    Padding="4"
                    CornerRadius="10"
                    Background="#FAF8F9FB"
                    BorderBrush="#22000000"
                    BorderThickness="1"
                    Cursor="Arrow">
                <Border.Effect>
                    <DropShadowEffect Color="#FF000000" BlurRadius="20" ShadowDepth="4" Opacity="0.24" />
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <StackPanel x:Name="PinColorGroup" Orientation="Horizontal">
                    <Button x:Name="ColorRedButton"
                            AutomationProperties.AutomationId="color.red"
                            Style="{StaticResource PinColorSwatchStyle}"
                            Tag="#FFFF5A5A"
                            ToolTip="红色"
                            AutomationProperties.Name="红色"
                            Click="AnnotationColor_Click">
                        <Ellipse Width="12" Height="12" Fill="#FFFF5A5A" />
                    </Button>
                    <Button x:Name="ColorOrangeButton"
                            AutomationProperties.AutomationId="color.orange"
                            Style="{StaticResource PinColorSwatchStyle}"
                            Tag="#FFFFA94D"
                            ToolTip="橙色"
                            AutomationProperties.Name="橙色"
                            Click="AnnotationColor_Click">
                        <Ellipse Width="12" Height="12" Fill="#FFFFA94D" />
                    </Button>
                    <Button x:Name="ColorYellowButton"
                            AutomationProperties.AutomationId="color.yellow"
                            Style="{StaticResource PinColorSwatchStyle}"
                            Tag="#FFFFD166"
                            ToolTip="黄色"
                            AutomationProperties.Name="黄色"
                            Click="AnnotationColor_Click">
                        <Ellipse Width="12" Height="12" Fill="#FFFFD166" />
                    </Button>
                    <Button x:Name="ColorGreenButton"
                            AutomationProperties.AutomationId="color.green"
                            Style="{StaticResource PinColorSwatchStyle}"
                            Tag="#FF7CE38B"
                            ToolTip="绿色"
                            AutomationProperties.Name="绿色"
                            Click="AnnotationColor_Click">
                        <Ellipse Width="12" Height="12" Fill="#FF7CE38B" />
                    </Button>
                    <Button x:Name="ColorBlueButton"
                            AutomationProperties.AutomationId="color.blue"
                            Style="{StaticResource PinColorSwatchStyle}"
                            Tag="#FF6CA8FF"
                            ToolTip="蓝色"
                            AutomationProperties.Name="蓝色"
                            Click="AnnotationColor_Click">
                        <Ellipse Width="12" Height="12" Fill="#FF6CA8FF" />
                    </Button>
                    <Button x:Name="ColorPurpleButton"
                            AutomationProperties.AutomationId="color.purple"
                            Style="{StaticResource PinColorSwatchStyle}"
                            Tag="#FFB08CFF"
                            ToolTip="紫色"
                            AutomationProperties.Name="紫色"
                            Click="AnnotationColor_Click">
                        <Ellipse Width="12" Height="12" Fill="#FFB08CFF" />
                    </Button>
                    <Button x:Name="ColorDarkButton"
                            AutomationProperties.AutomationId="color.dark"
                            Style="{StaticResource PinColorSwatchStyle}"
                            Tag="#FF242933"
                            ToolTip="黑色"
                            AutomationProperties.Name="黑色"
                            Click="AnnotationColor_Click">
                        <Ellipse Width="12" Height="12" Fill="#FF242933" Stroke="#5CFFFFFF" StrokeThickness="1" />
                    </Button>
                    <Button x:Name="ColorWhiteButton"
                            AutomationProperties.AutomationId="color.white"
                            Style="{StaticResource PinColorSwatchStyle}"
                            Tag="#FFFFFFFF"
                            ToolTip="白色"
                            AutomationProperties.Name="白色"
                            Click="AnnotationColor_Click">
                        <Ellipse Width="12" Height="12" Fill="#FFFFFFFF" Stroke="#26000000" StrokeThickness="1" />
                    </Button>
                    </StackPanel>

                    <Border x:Name="PinColorSeparator" Width="1" Margin="4,6" Background="#1A000000" />

                    <StackPanel x:Name="PinShapeKindGroup" Orientation="Horizontal">
                        <Button x:Name="ShapeRectangleButton"
                                AutomationProperties.AutomationId="option.shapeRectangle"
                                Style="{StaticResource PinOptionButtonStyle}"
                                Tag="Rectangle"
                                ToolTip="矩形 (R) · Shift 正方形"
                                Click="ShapeKind_Click">
                            <Viewbox Width="20" Height="20">
                                <Path Style="{StaticResource ToolbarIconStyle}" Data="{StaticResource ToolbarRectangleGeometry}" />
                            </Viewbox>
                        </Button>
                        <Button x:Name="ShapeEllipseButton"
                                AutomationProperties.AutomationId="option.shapeEllipse"
                                Style="{StaticResource PinOptionButtonStyle}"
                                Tag="Ellipse"
                                ToolTip="椭圆 (E) · Shift 正圆"
                                Click="ShapeKind_Click">
                            <Viewbox Width="20" Height="20">
                                <Path Style="{StaticResource ToolbarIconStyle}" Data="{StaticResource ToolbarEllipseGeometry}" />
                            </Viewbox>
                        </Button>
                    </StackPanel>

                    <StackPanel x:Name="PinShapeGroup" Orientation="Horizontal">
                        <Button x:Name="ShapeOutlineButton"
                                AutomationProperties.AutomationId="option.outline"
                                Style="{StaticResource PinOptionButtonStyle}"
                                Tag="Outline"
                                ToolTip="空心形状 (F 切换)"
                                Click="ShapeStyle_Click">
                            <Viewbox Width="20" Height="20">
                                <Path Style="{StaticResource ToolbarIconStyle}" Data="{StaticResource ToolbarOutlineGeometry}" />
                            </Viewbox>
                        </Button>
                        <Button x:Name="ShapeFillButton"
                                AutomationProperties.AutomationId="option.fill"
                                Style="{StaticResource PinOptionButtonStyle}"
                                Tag="Fill"
                                ToolTip="实心填充 (F 切换)"
                                Click="ShapeStyle_Click">
                            <Viewbox Width="20" Height="20">
                                <Path Style="{StaticResource ToolbarIconStyle}" Data="{StaticResource ToolbarFillGeometry}" />
                            </Viewbox>
                        </Button>
                    </StackPanel>

                    <StackPanel x:Name="PinBrushGroup" Orientation="Horizontal">
                        <Button Style="{StaticResource PinOptionButtonStyle}" Tag="Down" ToolTip="变细 (滚轮)" Click="OptionStep_Click">
                            <Viewbox Width="20" Height="20">
                                <Path Style="{StaticResource ToolbarIconStyle}" Data="{StaticResource ToolbarDecreaseGeometry}" />
                            </Viewbox>
                        </Button>
                        <TextBlock x:Name="BrushValueText" Width="24" FontSize="11.5" Foreground="#2A303B" TextAlignment="Center" VerticalAlignment="Center" />
                        <Button Style="{StaticResource PinOptionButtonStyle}" Tag="Up" ToolTip="变粗 (滚轮)" Click="OptionStep_Click">
                            <Viewbox Width="20" Height="20">
                                <Path Style="{StaticResource ToolbarIconStyle}" Data="{StaticResource ToolbarIncreaseGeometry}" />
                            </Viewbox>
                        </Button>
                    </StackPanel>

                    <StackPanel x:Name="PinArrowGroup" Orientation="Horizontal">
                        <Button x:Name="ArrowEndButton"
                                AutomationProperties.AutomationId="option.arrowEnd"
                                Style="{StaticResource PinOptionButtonStyle}"
                                Tag="End"
                                ToolTip="末端箭头"
                                Click="ArrowStyle_Click">
                            <Viewbox Width="20" Height="20">
                                <Path Style="{StaticResource ToolbarIconStyle}" Data="{StaticResource ToolbarArrowEndGeometry}" />
                            </Viewbox>
                        </Button>
                        <Button x:Name="ArrowBothButton"
                                AutomationProperties.AutomationId="option.arrowBoth"
                                Style="{StaticResource PinOptionButtonStyle}"
                                Tag="Both"
                                ToolTip="双向箭头"
                                Click="ArrowStyle_Click">
                            <Viewbox Width="20" Height="20">
                                <Path Style="{StaticResource ToolbarIconStyle}" Data="{StaticResource ToolbarArrowBothGeometry}" />
                            </Viewbox>
                        </Button>
                        <Button x:Name="ArrowLineButton"
                                AutomationProperties.AutomationId="option.arrowLine"
                                Style="{StaticResource PinOptionButtonStyle}"
                                Tag="None"
                                ToolTip="直线（无箭头）"
                                Click="ArrowStyle_Click">
                            <Viewbox Width="20" Height="20">
                                <Path Style="{StaticResource ToolbarIconStyle}" Data="{StaticResource ToolbarArrowLineGeometry}" />
                            </Viewbox>
                        </Button>
                    </StackPanel>

                    <StackPanel x:Name="PinTextGroup" Orientation="Horizontal">
                        <Button Style="{StaticResource PinOptionButtonStyle}" Tag="Down" ToolTip="变小 (滚轮)" Click="OptionStep_Click">
                            <Viewbox Width="20" Height="20">
                                <Path Style="{StaticResource ToolbarIconStyle}" Data="{StaticResource ToolbarDecreaseGeometry}" />
                            </Viewbox>
                        </Button>
                        <TextBlock x:Name="TextValueText" Width="24" FontSize="11.5" Foreground="#2A303B" TextAlignment="Center" VerticalAlignment="Center" />
                        <Button Style="{StaticResource PinOptionButtonStyle}" Tag="Up" ToolTip="变大 (滚轮)" Click="OptionStep_Click">
                            <Viewbox Width="20" Height="20">
                                <Path Style="{StaticResource ToolbarIconStyle}" Data="{StaticResource ToolbarIncreaseGeometry}" />
                            </Viewbox>
                        </Button>
                    </StackPanel>

                    <StackPanel x:Name="PinTextStyleGroup" Orientation="Horizontal">
                        <Button x:Name="BoldToggleButton"
                                AutomationProperties.AutomationId="option.bold"
                                Style="{StaticResource PinOptionButtonStyle}"
                                Tag="Bold"
                                ToolTip="加粗 (Ctrl+B)"
                                Click="TextStyle_Click">
                            <Viewbox Width="20" Height="20">
                                <Path Style="{StaticResource ToolbarIconStyle}" Data="{StaticResource ToolbarBoldGeometry}" />
                            </Viewbox>
                        </Button>
                        <Button x:Name="ItalicToggleButton"
                                AutomationProperties.AutomationId="option.italic"
                                Style="{StaticResource PinOptionButtonStyle}"
                                Tag="Italic"
                                ToolTip="斜体 (Ctrl+I)"
                                Click="TextStyle_Click">
                            <Viewbox Width="20" Height="20">
                                <Path Style="{StaticResource ToolbarIconStyle}" Data="{StaticResource ToolbarItalicGeometry}" />
                            </Viewbox>
                        </Button>
                    </StackPanel>

                    <StackPanel x:Name="PinMosaicGroup" Orientation="Horizontal">
                        <Button Style="{StaticResource PinOptionButtonStyle}" Tag="Down" ToolTip="更密 (滚轮)" Click="OptionStep_Click">
                            <Viewbox Width="20" Height="20">
                                <Path Style="{StaticResource ToolbarIconStyle}" Data="{StaticResource ToolbarDecreaseGeometry}" />
                            </Viewbox>
                        </Button>
                        <TextBlock x:Name="MosaicValueText" Width="24" FontSize="11.5" Foreground="#2A303B" TextAlignment="Center" VerticalAlignment="Center" />
                        <Button Style="{StaticResource PinOptionButtonStyle}" Tag="Up" ToolTip="更疏 (滚轮)" Click="OptionStep_Click">
                            <Viewbox Width="20" Height="20">
                                <Path Style="{StaticResource ToolbarIconStyle}" Data="{StaticResource ToolbarIncreaseGeometry}" />
                            </Viewbox>
                        </Button>
                    </StackPanel>

                    <StackPanel x:Name="PinEraserGroup" Orientation="Horizontal">
                        <Button Style="{StaticResource PinOptionButtonStyle}" Tag="Down" ToolTip="变小 (滚轮)" Click="OptionStep_Click">
                            <Viewbox Width="20" Height="20">
                                <Path Style="{StaticResource ToolbarIconStyle}" Data="{StaticResource ToolbarDecreaseGeometry}" />
                            </Viewbox>
                        </Button>
                        <TextBlock x:Name="EraserValueText" Width="24" FontSize="11.5" Foreground="#2A303B" TextAlignment="Center" VerticalAlignment="Center" />
                        <Button Style="{StaticResource PinOptionButtonStyle}" Tag="Up" ToolTip="变大 (滚轮)" Click="OptionStep_Click">
                            <Viewbox Width="20" Height="20">
                                <Path Style="{StaticResource ToolbarIconStyle}" Data="{StaticResource ToolbarIncreaseGeometry}" />
                            </Viewbox>
                        </Button>
                    </StackPanel>

                </StackPanel>
            </Border>
            </StackPanel>
        </Viewbox>

        <Border x:Name="Hud"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,10"
                Padding="10,5"
                CornerRadius="7"
                Background="#D910141C"
                BorderBrush="#2AFFFFFF"
                BorderThickness="1"
                Opacity="0"
                IsHitTestVisible="False">
            <TextBlock x:Name="HudText"
