<Window x:Class="HaloCap.UI.PinWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HaloCap 贴图"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="True"
        Background="#FF0B0E14"
        SnapsToDevicePixels="True"
        FontFamily="{StaticResource AppFont}"
        Cursor="SizeAll"
        PreviewKeyDown="Window_PreviewKeyDown"
        MouseWheel="Window_MouseWheel">
    <Window.Resources>
        <Style x:Key="PinMenuStyle" TargetType="ContextMenu">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="#F2171C25"
                                BorderBrush="#33FFFFFF"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="6">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PinMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="#E7EDF6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Host"
                                Background="Transparent"
                                CornerRadius="6"
                                Padding="12,7">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="{TemplateBinding InputGestureText}"
                                           Foreground="#7D8797"
                                           FontSize="10.5"
                                           Margin="20,0,0,0"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Host" Property="Background" Value="#1CFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PinSeparatorStyle" TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="#1FFFFFFF" Margin="8,5" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.ContextMenu>
        <ContextMenu Style="{StaticResource PinMenuStyle}">
            <MenuItem Header="复制图片"
                      InputGestureText="Ctrl+C"
                      Style="{StaticResource PinMenuItemStyle}"
                      Click="CopyMenuItem_Click" />
            <MenuItem Header="保存图片…"
                      InputGestureText="Ctrl+S"
                      Style="{StaticResource PinMenuItemStyle}"
                      Click="SaveMenuItem_Click" />
            <Separator Style="{StaticResource PinSeparatorStyle}" />
            <MenuItem Header="恢复初始大小"
                      InputGestureText="Ctrl+0"
                      Style="{StaticResource PinMenuItemStyle}"
                      Click="ResetMenuItem_Click" />
            <Separator Style="{StaticResource PinSeparatorStyle}" />
            <MenuItem Header="关闭此贴图"
                      InputGestureText="Esc"
                      Style="{StaticResource PinMenuItemStyle}"
                      Click="CloseMenuItem_Click" />
            <MenuItem Header="关闭全部贴图"
                      Style="{StaticResource PinMenuItemStyle}"
                      Click="CloseAllMenuItem_Click" />
        </ContextMenu>
    </Window.ContextMenu>

    <Grid x:Name="Root"
          Background="#FF0B0E14"
          Focusable="True"
          MouseLeftButtonDown="Root_MouseLeftButtonDown">
        <Image x:Name="PreviewImage"
               Stretch="Fill"
               RenderOptions.BitmapScalingMode="HighQuality"
               SnapsToDevicePixels="True" />

        <Border BorderBrush="#40FFFFFF"
                BorderThickness="1"
                IsHitTestVisible="False" />

        <Border x:Name="Hud"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,10,0,0"
                Padding="10,5"
                CornerRadius="7"
                Background="#D910141C"
                BorderBrush="#2AFFFFFF"
                BorderThickness="1"
                Opacity="0"
                IsHitTestVisible="False">
            <TextBlock x:Name="HudText"
                       FontSize="11"
                       Foreground="#EAF0F8" />
        </Border>
    </Grid>
</Window>
