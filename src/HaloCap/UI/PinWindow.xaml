<Window x:Class="HaloCap.UI.PinWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HaloCap.UI"
        Title="HaloCap 贴图"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="True"
        Background="#FF0B0E14"
        SnapsToDevicePixels="True"
        FontFamily="{StaticResource AppFont}"
        Cursor="SizeAll"
        PreviewKeyDown="Window_PreviewKeyDown"
        MouseWheel="Window_MouseWheel">
    <Window.Resources>
        <Style x:Key="PinMenuStyle" TargetType="ContextMenu">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="#F2171C25"
                                BorderBrush="#33FFFFFF"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="6">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PinMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="#E7EDF6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Host"
                                Background="Transparent"
                                CornerRadius="6"
                                Padding="12,7">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="{TemplateBinding InputGestureText}"
                                           Foreground="#7D8797"
                                           FontSize="10.5"
                                           Margin="20,0,0,0"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Host" Property="Background" Value="#1CFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PinSeparatorStyle" TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="#1FFFFFFF" Margin="8,5" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PinToolButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#3C4250" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Host"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Host" Property="Background" Value="#14000000" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.32" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PinToolIconStyle" TargetType="Path">
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            <Setter Property="StrokeThickness" Value="1.35" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="Width" Value="15" />
            <Setter Property="Height" Value="15" />
        </Style>

        <Style x:Key="PinColorSwatchStyle" TargetType="Button">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Ring"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="2"
                                CornerRadius="12"
                                Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Background" Value="#14000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PinBarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#2A303B" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Host"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Host" Property="Background" Value="#14000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.ContextMenu>
        <ContextMenu Style="{StaticResource PinMenuStyle}">
            <MenuItem Header="标注图片"
                      InputGestureText="Space"
                      Style="{StaticResource PinMenuItemStyle}"
                      Click="AnnotateMenuItem_Click" />
            <Separator Style="{StaticResource PinSeparatorStyle}" />
            <MenuItem Header="复制图片"
                      InputGestureText="Ctrl+C"
                      Style="{StaticResource PinMenuItemStyle}"
                      Click="CopyMenuItem_Click" />
            <MenuItem Header="保存图片…"
                      InputGestureText="Ctrl+S"
                      Style="{StaticResource PinMenuItemStyle}"
                      Click="SaveMenuItem_Click" />
            <Separator Style="{StaticResource PinSeparatorStyle}" />
            <MenuItem Header="恢复初始大小"
                      InputGestureText="Ctrl+0"
                      Style="{StaticResource PinMenuItemStyle}"
                      Click="ResetMenuItem_Click" />
            <Separator Style="{StaticResource PinSeparatorStyle}" />
            <MenuItem Header="关闭此贴图"
                      InputGestureText="Esc"
                      Style="{StaticResource PinMenuItemStyle}"
                      Click="CloseMenuItem_Click" />
            <MenuItem Header="关闭全部贴图"
                      Style="{StaticResource PinMenuItemStyle}"
                      Click="CloseAllMenuItem_Click" />
        </ContextMenu>
    </Window.ContextMenu>

    <Grid x:Name="Root"
          Background="#FF0B0E14"
          Focusable="True"
          MouseLeftButtonDown="Root_MouseLeftButtonDown"
          PreviewMouseLeftButtonDown="Root_PreviewMouseLeftButtonDown"
          PreviewMouseMove="Root_PreviewMouseMove"
          PreviewMouseLeftButtonUp="Root_PreviewMouseLeftButtonUp">
        <Image x:Name="PreviewImage"
               Stretch="Fill"
               RenderOptions.BitmapScalingMode="HighQuality"
               SnapsToDevicePixels="True" />

        <local:AnnotationCanvas x:Name="AnnotationView"
                                IsHitTestVisible="False"
                                ClipToBounds="True" />

        <Border BorderBrush="#40FFFFFF"
                BorderThickness="1"
                IsHitTestVisible="False" />

        <Canvas x:Name="EditorLayer" ClipToBounds="True" />

        <Viewbox x:Name="AnnotationBarHost"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Top"
                 Margin="8"
                 Stretch="Uniform"
                 StretchDirection="DownOnly"
                 Visibility="Collapsed"
                 Panel.ZIndex="10">
            <Border x:Name="AnnotationBar"
                    Padding="4"
                    CornerRadius="10"
                    Background="#FAF8F9FB"
                    BorderBrush="#22000000"
                    BorderThickness="1"
                    Cursor="Arrow">
                <Border.Effect>
                    <DropShadowEffect Color="#FF000000" BlurRadius="20" ShadowDepth="4" Opacity="0.24" />
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="ToolPenButton"
                            AutomationProperties.AutomationId="tool.pen"
                            Style="{StaticResource PinToolButtonStyle}"
                            Tag="Pen"
                            ToolTip="画笔 (P) · 滚轮调粗细"
                            Click="AnnotationTool_Click">
                        <Viewbox Width="15" Height="15">
                            <Path Style="{StaticResource PinToolIconStyle}"
                                  Data="M4 20l4-1 10-10-3-3L5 16l-1 4Z M14 6l4 4" />
                        </Viewbox>
                    </Button>
                    <Button x:Name="ToolRectangleButton"
                            AutomationProperties.AutomationId="tool.rectangle"
                            Style="{StaticResource PinToolButtonStyle}"
                            Tag="Rectangle"
                            ToolTip="矩形 (R) · Shift 正方形"
                            Click="AnnotationTool_Click">
                        <Viewbox Width="15" Height="15">
                            <Path Style="{StaticResource PinToolIconStyle}" Data="M4 5h16v14H4Z" />
                        </Viewbox>
                    </Button>
                    <Button x:Name="ToolEllipseButton"
                            AutomationProperties.AutomationId="tool.ellipse"
                            Style="{StaticResource PinToolButtonStyle}"
                            Tag="Ellipse"
                            ToolTip="椭圆 (E) · Shift 正圆"
                            Click="AnnotationTool_Click">
                        <Viewbox Width="15" Height="15">
                            <Path Style="{StaticResource PinToolIconStyle}"
                                  Data="M12 5c4.4 0 8 3.1 8 7s-3.6 7-8 7-8-3.1-8-7 3.6-7 8-7Z" />
                        </Viewbox>
                    </Button>
                    <Button x:Name="ToolArrowButton"
                            AutomationProperties.AutomationId="tool.arrow"
                            Style="{StaticResource PinToolButtonStyle}"
                            Tag="Arrow"
                            ToolTip="箭头 (A) · Shift 锁定角度"
                            Click="AnnotationTool_Click">
                        <Viewbox Width="15" Height="15">
                            <Path Style="{StaticResource PinToolIconStyle}" Data="M5 19L19 5 M11 5h8v8" />
                        </Viewbox>
                    </Button>
                    <Button x:Name="ToolTextButton"
                            AutomationProperties.AutomationId="tool.text"
                            Style="{StaticResource PinToolButtonStyle}"
                            Tag="Text"
                            ToolTip="文字 (T) · 滚轮调字号"
                            Click="AnnotationTool_Click">
                        <Viewbox Width="15" Height="15">
                            <Path Style="{StaticResource PinToolIconStyle}" Data="M5 6V4h14v2 M12 4v16 M9 20h6" />
                        </Viewbox>
                    </Button>
                    <Button x:Name="ToolHighlighterButton"
                            AutomationProperties.AutomationId="tool.highlighter"
                            Style="{StaticResource PinToolButtonStyle}"
                            Tag="Highlighter"
                            ToolTip="荧光笔 (H) · 滚轮调粗细"
                            Click="AnnotationTool_Click">
                        <Viewbox Width="15" Height="15">
                            <Path Style="{StaticResource PinToolIconStyle}"
                                  Data="M6 20h12 M8 16l-2 2 M8 16l8-9 3 3-8 9H8Z" />
                        </Viewbox>
                    </Button>
                    <Button x:Name="ToolMosaicButton"
                            AutomationProperties.AutomationId="tool.mosaic"
                            Style="{StaticResource PinToolButtonStyle}"
                            Tag="Mosaic"
                            ToolTip="马赛克 (M) · 滚轮调密度"
                            Click="AnnotationTool_Click">
                        <Viewbox Width="15" Height="15">
                            <Path Style="{StaticResource PinToolIconStyle}"
                                  Data="M4 4h6v6H4Z M14 4h6v6h-6Z M4 14h6v6H4Z M14 14h6v6h-6Z" />
                        </Viewbox>
                    </Button>
                    <Button x:Name="ToolEraserButton"
                            AutomationProperties.AutomationId="tool.eraser"
                            Style="{StaticResource PinToolButtonStyle}"
                            Tag="Eraser"
                            ToolTip="橡皮擦 (X) · 滚轮调大小 · 划过删除整条标注"
                            Click="AnnotationTool_Click">
                        <Viewbox Width="15" Height="15">
                            <Path Style="{StaticResource PinToolIconStyle}"
                                  Data="M4 20h16 M7 17.5L14 7l4 3.2-7 10H7v-2.7Z M11 12l4 3.2" />
                        </Viewbox>
                    </Button>
                    <Button x:Name="ToolStepButton"
                            AutomationProperties.AutomationId="tool.step"
                            Style="{StaticResource PinToolButtonStyle}"
                            Tag="Step"
                            ToolTip="序号 (N)"
                            Click="AnnotationTool_Click">
                        <Viewbox Width="15" Height="15">
                            <Path Style="{StaticResource PinToolIconStyle}"
                                  Data="M12 3.5a8.5 8.5 0 1 1 0 17 8.5 8.5 0 0 1 0-17Z M10.5 9l1.7-1.3V16 M9.8 16h4.6" />
                        </Viewbox>
                    </Button>

                    <Border Width="1" Margin="4,6" Background="#26FFFFFF" />

                    <StackPanel x:Name="PinColorGroup" Orientation="Horizontal">
                    <Button x:Name="ColorRedButton"
                            AutomationProperties.AutomationId="color.red"
                            Style="{StaticResource PinColorSwatchStyle}"
                            Tag="#FFFF5A5A"
                            ToolTip="红色"
                            AutomationProperties.Name="红色"
                            Click="AnnotationColor_Click">
                        <Ellipse Width="12" Height="12" Fill="#FFFF5A5A" />
                    </Button>
                    <Button x:Name="ColorOrangeButton"
                            AutomationProperties.AutomationId="color.orange"
                            Style="{StaticResource PinColorSwatchStyle}"
                            Tag="#FFFFA94D"
                            ToolTip="橙色"
                            AutomationProperties.Name="橙色"
                            Click="AnnotationColor_Click">
                        <Ellipse Width="12" Height="12" Fill="#FFFFA94D" />
                    </Button>
                    <Button x:Name="ColorYellowButton"
                            AutomationProperties.AutomationId="color.yellow"
                            Style="{StaticResource PinColorSwatchStyle}"
                            Tag="#FFFFD166"
                            ToolTip="黄色"
                            AutomationProperties.Name="黄色"
                            Click="AnnotationColor_Click">
                        <Ellipse Width="12" Height="12" Fill="#FFFFD166" />
                    </Button>
                    <Button x:Name="ColorGreenButton"
                            AutomationProperties.AutomationId="color.green"
                            Style="{StaticResource PinColorSwatchStyle}"
                            Tag="#FF7CE38B"
                            ToolTip="绿色"
                            AutomationProperties.Name="绿色"
                            Click="AnnotationColor_Click">
                        <Ellipse Width="12" Height="12" Fill="#FF7CE38B" />
                    </Button>
                    <Button x:Name="ColorBlueButton"
                            AutomationProperties.AutomationId="color.blue"
                            Style="{StaticResource PinColorSwatchStyle}"
                            Tag="#FF6CA8FF"
                            ToolTip="蓝色"
                            AutomationProperties.Name="蓝色"
                            Click="AnnotationColor_Click">
                        <Ellipse Width="12" Height="12" Fill="#FF6CA8FF" />
                    </Button>
                    <Button x:Name="ColorPurpleButton"
                            AutomationProperties.AutomationId="color.purple"
                            Style="{StaticResource PinColorSwatchStyle}"
                            Tag="#FFB08CFF"
                            ToolTip="紫色"
                            AutomationProperties.Name="紫色"
                            Click="AnnotationColor_Click">
                        <Ellipse Width="12" Height="12" Fill="#FFB08CFF" />
                    </Button>
                    <Button x:Name="ColorDarkButton"
                            AutomationProperties.AutomationId="color.dark"
                            Style="{StaticResource PinColorSwatchStyle}"
                            Tag="#FF242933"
                            ToolTip="黑色"
                            AutomationProperties.Name="黑色"
                            Click="AnnotationColor_Click">
                        <Ellipse Width="12" Height="12" Fill="#FF242933" Stroke="#5CFFFFFF" StrokeThickness="1" />
                    </Button>
                    <Button x:Name="ColorWhiteButton"
                            AutomationProperties.AutomationId="color.white"
                            Style="{StaticResource PinColorSwatchStyle}"
                            Tag="#FFFFFFFF"
                            ToolTip="白色"
                            AutomationProperties.Name="白色"
                            Click="AnnotationColor_Click">
                        <Ellipse Width="12" Height="12" Fill="#FFFFFFFF" Stroke="#26000000" StrokeThickness="1" />
                    </Button>
                    </StackPanel>

                    <StackPanel x:Name="PinShapeGroup" Orientation="Horizontal">
                        <TextBlock Text="样式" FontSize="11" Foreground="#5A6270" Margin="6,0,4,0" VerticalAlignment="Center" />
                        <Button x:Name="ShapeOutlineButton"
                                AutomationProperties.AutomationId="option.outline"
                                Style="{StaticResource PinToolButtonStyle}"
                                Tag="Outline"
                                ToolTip="空心形状 (F 切换)"
                                Click="ShapeStyle_Click">
                            <Viewbox Width="15" Height="15">
                                <Path Style="{StaticResource PinToolIconStyle}" Data="M4 5h16v14H4Z" />
                            </Viewbox>
                        </Button>
                        <Button x:Name="ShapeFillButton"
                                AutomationProperties.AutomationId="option.fill"
                                Style="{StaticResource PinToolButtonStyle}"
                                Tag="Fill"
                                ToolTip="实心填充 (F 切换)"
                                Click="ShapeStyle_Click">
                            <Viewbox Width="15" Height="15">
                                <Path Style="{StaticResource PinToolIconStyle}"
                                      Data="M4 5h16v14H4Z"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Viewbox>
                        </Button>
                    </StackPanel>

                    <StackPanel x:Name="PinBrushGroup" Orientation="Horizontal">
                        <TextBlock Text="粗细" FontSize="11" Foreground="#5A6270" Margin="4,0,5,0" VerticalAlignment="Center" />
                        <Button Style="{StaticResource PinBarButtonStyle}" Padding="6,3" Tag="Down" ToolTip="变细 (滚轮)" Content="−" Click="OptionStep_Click" />
                        <TextBlock x:Name="BrushValueText" Width="24" FontSize="11.5" Foreground="#2A303B" TextAlignment="Center" VerticalAlignment="Center" />
                        <Button Style="{StaticResource PinBarButtonStyle}" Padding="6,3" Tag="Up" ToolTip="变粗 (滚轮)" Content="+" Click="OptionStep_Click" />
                    </StackPanel>

                    <StackPanel x:Name="PinArrowGroup" Orientation="Horizontal">
                        <TextBlock Text="箭头" FontSize="11" Foreground="#5A6270" Margin="6,0,4,0" VerticalAlignment="Center" />
                        <Button x:Name="ArrowEndButton"
                                AutomationProperties.AutomationId="option.arrowEnd"
                                Style="{StaticResource PinToolButtonStyle}"
                                Tag="End"
                                ToolTip="末端箭头"
                                Click="ArrowStyle_Click">
                            <Viewbox Width="15" Height="15">
                                <Path Style="{StaticResource PinToolIconStyle}" Data="M4 12h14 M12 6l6 6-6 6" />
                            </Viewbox>
                        </Button>
                        <Button x:Name="ArrowBothButton"
                                AutomationProperties.AutomationId="option.arrowBoth"
                                Style="{StaticResource PinToolButtonStyle}"
                                Tag="Both"
                                ToolTip="双向箭头"
                                Click="ArrowStyle_Click">
                            <Viewbox Width="15" Height="15">
                                <Path Style="{StaticResource PinToolIconStyle}"
                                      Data="M4 12h16 M4 12l5-5 M4 12l5 5 M20 12l-5-5 M20 12l-5 5" />
                            </Viewbox>
                        </Button>
                        <Button x:Name="ArrowLineButton"
                                AutomationProperties.AutomationId="option.arrowLine"
                                Style="{StaticResource PinToolButtonStyle}"
                                Tag="None"
                                ToolTip="直线（无箭头）"
                                Click="ArrowStyle_Click">
                            <Viewbox Width="15" Height="15">
                                <Path Style="{StaticResource PinToolIconStyle}" Data="M4 12h16" />
                            </Viewbox>
                        </Button>
                    </StackPanel>

                    <StackPanel x:Name="PinTextGroup" Orientation="Horizontal">
                        <TextBlock Text="字号" FontSize="11" Foreground="#5A6270" Margin="4,0,5,0" VerticalAlignment="Center" />
                        <Button Style="{StaticResource PinBarButtonStyle}" Padding="6,3" Tag="Down" ToolTip="变小 (滚轮)" Content="−" Click="OptionStep_Click" />
                        <TextBlock x:Name="TextValueText" Width="24" FontSize="11.5" Foreground="#2A303B" TextAlignment="Center" VerticalAlignment="Center" />
                        <Button Style="{StaticResource PinBarButtonStyle}" Padding="6,3" Tag="Up" ToolTip="变大 (滚轮)" Content="+" Click="OptionStep_Click" />
                    </StackPanel>

                    <StackPanel x:Name="PinTextStyleGroup" Orientation="Horizontal">
                        <Button x:Name="BoldToggleButton"
                                AutomationProperties.AutomationId="option.bold"
                                Style="{StaticResource PinToolButtonStyle}"
                                Tag="Bold"
                                ToolTip="加粗 (Ctrl+B)"
                                Click="TextStyle_Click">
                            <TextBlock Text="B"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                        <Button x:Name="ItalicToggleButton"
                                AutomationProperties.AutomationId="option.italic"
                                Style="{StaticResource PinToolButtonStyle}"
                                Tag="Italic"
                                ToolTip="斜体 (Ctrl+I)"
                                Click="TextStyle_Click">
                            <TextBlock Text="I"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       FontStyle="Italic"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                    </StackPanel>

                    <StackPanel x:Name="PinMosaicGroup" Orientation="Horizontal">
                        <TextBlock Text="密度" FontSize="11" Foreground="#5A6270" Margin="4,0,5,0" VerticalAlignment="Center" />
                        <Button Style="{StaticResource PinBarButtonStyle}" Padding="6,3" Tag="Down" ToolTip="更密 (滚轮)" Content="−" Click="OptionStep_Click" />
                        <TextBlock x:Name="MosaicValueText" Width="24" FontSize="11.5" Foreground="#2A303B" TextAlignment="Center" VerticalAlignment="Center" />
                        <Button Style="{StaticResource PinBarButtonStyle}" Padding="6,3" Tag="Up" ToolTip="更疏 (滚轮)" Content="+" Click="OptionStep_Click" />
                    </StackPanel>

                    <StackPanel x:Name="PinEraserGroup" Orientation="Horizontal">
                        <TextBlock Text="大小" FontSize="11" Foreground="#5A6270" Margin="4,0,5,0" VerticalAlignment="Center" />
                        <Button Style="{StaticResource PinBarButtonStyle}" Padding="6,3" Tag="Down" ToolTip="变小 (滚轮)" Content="−" Click="OptionStep_Click" />
                        <TextBlock x:Name="EraserValueText" Width="24" FontSize="11.5" Foreground="#2A303B" TextAlignment="Center" VerticalAlignment="Center" />
                        <Button Style="{StaticResource PinBarButtonStyle}" Padding="6,3" Tag="Up" ToolTip="变大 (滚轮)" Content="+" Click="OptionStep_Click" />
                    </StackPanel>

                    <Border Width="1" Margin="4,6" Background="#26FFFFFF" />

                    <Button x:Name="UndoButton"
                            AutomationProperties.AutomationId="history.undo"
                            Style="{StaticResource PinToolButtonStyle}"
                            Tag="Undo"
                            ToolTip="撤销 (Ctrl+Z)"
                            Click="AnnotationAction_Click">
                        <Viewbox Width="15" Height="15">
                            <Path Style="{StaticResource PinToolIconStyle}"
                                  Data="M9 6L4 11l5 5 M4 11h9a5 5 0 0 1 5 5v2" />
                        </Viewbox>
                    </Button>
                    <Button x:Name="RedoButton"
                            AutomationProperties.AutomationId="history.redo"
                            Style="{StaticResource PinToolButtonStyle}"
                            Tag="Redo"
                            ToolTip="重做 (Ctrl+Y)"
                            Click="AnnotationAction_Click">
                        <Viewbox Width="15" Height="15">
                            <Path Style="{StaticResource PinToolIconStyle}"
                                  Data="M15 6l5 5-5 5 M20 11h-9a5 5 0 0 0-5 5v2" />
                        </Viewbox>
                    </Button>
                    <Button x:Name="ClearButton"
                            AutomationProperties.AutomationId="history.clear"
                            Style="{StaticResource PinToolButtonStyle}"
                            Tag="Clear"
                            ToolTip="清空标注"
                            Click="AnnotationAction_Click">
                        <Viewbox Width="15" Height="15">
                            <Path Style="{StaticResource PinToolIconStyle}"
                                  Data="M5 7h14 M9 7V4h6v3 M7 7l1 13h8l1-13 M10 11v6 M14 11v6" />
                        </Viewbox>
                    </Button>
                    <Button Style="{StaticResource PinBarButtonStyle}"
                            Tag="Done"
                            Foreground="#FFFFFFFF"
                            Background="#FF2F7CF6"
                            ToolTip="退出标注 (Space)"
                            Click="AnnotationAction_Click"
                            Content="完成" />
                </StackPanel>
            </Border>
        </Viewbox>

        <Border x:Name="Hud"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,10"
                Padding="10,5"
                CornerRadius="7"
                Background="#D910141C"
                BorderBrush="#2AFFFFFF"
                BorderThickness="1"
                Opacity="0"
                IsHitTestVisible="False">
            <TextBlock x:Name="HudText"
                       FontSize="11"
                       Foreground="#EAF0F8" />
        </Border>
    </Grid>
</Window>
