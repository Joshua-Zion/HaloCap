<Window x:Class="HaloCap.UI.RadialMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="380"
        Height="380"
        Left="-10000"
        Top="-10000"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False"
        FocusVisualStyle="{x:Null}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextRenderingMode="Grayscale"
        FontFamily="{StaticResource AppFont}"
        Opacity="0">
    <Grid x:Name="Root"
          RenderTransformOrigin="0.5,0.5"
          IsHitTestVisible="False"
          Background="#01000000">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1" />
        </Grid.RenderTransform>

        <Ellipse x:Name="OuterDisk"
                 Width="340"
                 Height="340"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center">
            <Ellipse.Fill>
                <RadialGradientBrush Center="0.5,0.36"
                                     GradientOrigin="0.5,0.36"
                                     RadiusX="0.74"
                                     RadiusY="0.74">
                    <GradientStop Color="#FFFFFFFF" Offset="0" />
                    <GradientStop Color="#FFF8F9FB" Offset="0.62" />
                    <GradientStop Color="#FFEFF1F5" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.Stroke>
                <SolidColorBrush Color="#1A000000" />
            </Ellipse.Stroke>
            <Ellipse.Effect>
                <DropShadowEffect Color="#FF000000"
                                  BlurRadius="30"
                                  ShadowDepth="2"
                                  Opacity="0.22" />
            </Ellipse.Effect>
        </Ellipse>

        <Canvas x:Name="SectorLayer"
                Width="380"
                Height="380"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsHitTestVisible="False" />
        <Canvas x:Name="ItemLayer"
                Width="380"
                Height="380"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsHitTestVisible="False" />

        <Grid Width="112"
              Height="112"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              IsHitTestVisible="False">
            <Ellipse x:Name="CenterDisk"
                     Width="104"
                     Height="104"
                     Fill="#FFFFFFFF"
                     Stroke="#14000000"
                     StrokeThickness="1">
                <Ellipse.Effect>
                    <DropShadowEffect Color="#FF000000"
                                      BlurRadius="16"
                                      ShadowDepth="2"
                                      Opacity="0.12" />
                </Ellipse.Effect>
            </Ellipse>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse x:Name="CenterDot"
                         Width="6"
                         Height="6"
                         Fill="#FFF5B963"
                         HorizontalAlignment="Center"
                         Margin="0,0,0,8"
                         Visibility="Collapsed" />
                <TextBlock x:Name="CenterTitle"
                           Text="HaloCap"
                           FontSize="13.5"
                           FontWeight="SemiBold"
                           Foreground="#FF1D1D1F"
                           HorizontalAlignment="Center"
                           TextAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
