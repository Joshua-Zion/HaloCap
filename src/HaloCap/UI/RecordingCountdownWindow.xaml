<Window x:Class="HaloCap.UI.RecordingCountdownWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HaloCap 录屏倒计时"
        Width="148"
        Height="148"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        FocusVisualStyle="{x:Null}"
        FontFamily="{StaticResource AppFont}">
    <Grid>
        <Border x:Name="Card"
                Width="118"
                Height="118"
                CornerRadius="30"
                Background="#F2FFFFFF"
                BorderBrush="#1F000000"
                BorderThickness="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="#FF8A8F9C" BlurRadius="22" ShadowDepth="4" Opacity="0.35" />
            </Border.Effect>

            <Grid>
                <TextBlock x:Name="CountText"
                           Text="3"
                           FontSize="54"
                           FontWeight="SemiBold"
                           Foreground="#FF1C1E24"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="0,-8,0,0" />
                <TextBlock Text="开始录屏"
                           FontSize="10.5"
                           Foreground="#FF757A88"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Bottom"
                           Margin="0,0,0,17" />
            </Grid>
        </Border>
    </Grid>
</Window>
