<Window x:Class="HaloCap.UI.RecordingFrameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HaloCap 录制区域"
        Width="1"
        Height="1"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        FocusVisualStyle="{x:Null}"
        IsHitTestVisible="False">
    <Grid>
        <Border BorderThickness="2" BorderBrush="#FFFF7A7A" />
        <Border BorderThickness="1" BorderBrush="#59000000" Margin="2" />
    </Grid>
</Window>
