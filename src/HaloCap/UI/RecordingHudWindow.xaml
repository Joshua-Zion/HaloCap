<Window x:Class="HaloCap.UI.RecordingHudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HaloCap 录制中"
        Width="396"
        Height="46"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        FocusVisualStyle="{x:Null}"
        FontFamily="{StaticResource AppFont}">
    <Window.Resources>
        <Style x:Key="HudStopButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="#FF2A2E37" />
            <Setter Property="Background" Value="#0A000000" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Host"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="8,5"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Host" Property="Background" Value="#1FE0312B" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Host" Property="Background" Value="#14E0312B" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HudPauseButtonStyle" TargetType="Button" BasedOn="{StaticResource HudStopButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Host"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="8,5"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Host" Property="Background" Value="#14000000" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Host" Property="Background" Value="#0A000000" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Border CornerRadius="13"
                Background="#F2FFFFFF"
                BorderBrush="#1F000000"
                BorderThickness="1"
                Padding="13,0">
            <Border.Effect>
                <DropShadowEffect Color="#FF8A8F9C" BlurRadius="18" ShadowDepth="3" Opacity="0.35" />
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Width="15" Height="15" VerticalAlignment="Center">
                    <Ellipse Width="15" Height="15" Fill="#33E0312B" />
                    <Ellipse x:Name="PulseDot"
                             Width="8"
                             Height="8"
                             Fill="#FFE0312B"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center" />
                </Grid>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="8,0,0,0">
                    <TextBlock x:Name="StateText"
                               Text="REC"
                               FontSize="9.5"
                               FontWeight="Bold"
                               FontFamily="Consolas"
                               Foreground="#FFE0312B"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="TimerText"
                               Text="00:00"
                               FontSize="12.5"
                               FontFamily="Consolas"
                               Foreground="#FF1C1E24"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="10,0,10,0">
                    <TextBlock x:Name="InfoText"
                               Text=""
                               FontSize="10"
                               Foreground="#FF757A88"
                               TextTrimming="CharacterEllipsis" />
                    <StackPanel x:Name="LevelRow"
                                Orientation="Horizontal"
                                Margin="0,4,0,0"
                                Visibility="Collapsed">
                        <Border x:Name="SystemMeterTrack"
                                Width="46"
                                Height="3"
                                Background="#14000000"
                                CornerRadius="1.5"
                                Margin="0,0,4,0"
                                ToolTip="系统声音电平">
                            <Border x:Name="SystemMeter"
                                    Width="0"
                                    Background="#FF18A05B"
                                    CornerRadius="1.5"
                                    HorizontalAlignment="Left" />
                        </Border>
                        <Border x:Name="MicMeterTrack"
                                Width="46"
                                Height="3"
                                Background="#14000000"
                                CornerRadius="1.5"
                                Visibility="Collapsed"
                                ToolTip="麦克风电平">
                            <Border x:Name="MicMeter"
                                    Width="0"
                                    Background="#FFE08A00"
                                    CornerRadius="1.5"
                                    HorizontalAlignment="Left" />
                        </Border>
                    </StackPanel>
                </StackPanel>

                <Button x:Name="PauseButton"
                        Grid.Column="3"
                        Style="{StaticResource HudPauseButtonStyle}"
                        VerticalAlignment="Center"
                        Margin="0,0,6,0"
                        ToolTip="暂停录制"
                        AutomationProperties.Name="暂停录制"
                        Click="PauseButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <Rectangle Width="3" Height="8" Fill="#FF2A2E37" />
                        <Rectangle Width="3" Height="8" Fill="#FF2A2E37" Margin="2,0,0,0" />
                        <TextBlock x:Name="PauseLabel" Text="暂停" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button x:Name="StopButton"
                        Grid.Column="4"
                        Style="{StaticResource HudStopButtonStyle}"
                        VerticalAlignment="Center"
                        ToolTip="停止录制"
                        AutomationProperties.Name="停止录制"
                        Click="StopButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <Rectangle Width="8" Height="8" Fill="#FF2A2E37" RadiusX="1.5" RadiusY="1.5" />
                        <TextBlock Text="停止" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>

