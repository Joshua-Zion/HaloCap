<Window x:Class="HaloCap.UI.RecordingHudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HaloCap 录制中"
        Width="246"
        Height="46"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        FontFamily="{StaticResource AppFont}">
    <Window.Resources>
        <Style x:Key="HudStopButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#F0F4FA" />
            <Setter Property="Background" Value="#14FFFFFF" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Host"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="8,5"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Host" Property="Background" Value="#33FF7A7A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Host" Property="Background" Value="#22FF7A7A" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Border CornerRadius="13"
                Background="#F210141C"
                BorderBrush="#38FFFFFF"
                BorderThickness="1"
                Padding="13,0">
            <Border.Effect>
                <DropShadowEffect Color="#FF000000" BlurRadius="22" ShadowDepth="5" Opacity="0.5" />
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Width="15" Height="15" VerticalAlignment="Center">
                    <Ellipse Width="15" Height="15" Fill="#33FF6B6B" />
                    <Ellipse x:Name="PulseDot"
                             Width="8"
                             Height="8"
                             Fill="#FFFF6B6B"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center" />
                </Grid>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="8,0,0,0">
                    <TextBlock Text="REC"
                               FontSize="9.5"
                               FontWeight="Bold"
                               FontFamily="Consolas"
                               Foreground="#FFFF8C8C"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="TimerText"
                               Text="00:00"
                               FontSize="12.5"
                               FontFamily="Consolas"
                               Foreground="#F2F6FA"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>

                <Button x:Name="StopButton"
                        Grid.Column="3"
                        Style="{StaticResource HudStopButtonStyle}"
                        VerticalAlignment="Center"
                        ToolTip="停止录制"
                        AutomationProperties.Name="停止录制"
                        Click="StopButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <Rectangle Width="8" Height="8" Fill="#FFE8EDF5" RadiusX="1.5" RadiusY="1.5" />
                        <TextBlock Text="停止" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
