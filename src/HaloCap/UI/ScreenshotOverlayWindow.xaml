<Window x:Class="HaloCap.UI.ScreenshotOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HaloCap.UI"
        Title="HaloCap 选区"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        SnapsToDevicePixels="True"
        UseLayoutRounding="False"
        FontFamily="{StaticResource AppFont}"
        Cursor="Cross"
        KeyDown="Window_KeyDown"
        MouseWheel="Window_MouseWheel">
    <Window.Resources>
        <Style x:Key="OverlayButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#2A303B" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="9,7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Host"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Host" Property="Background" Value="#14000000" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Host" Property="Background" Value="#22000000" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OverlayIconStyle" TargetType="Path">
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            <Setter Property="StrokeThickness" Value="1.35" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="Width" Value="15" />
            <Setter Property="Height" Value="15" />
        </Style>

        <Style x:Key="HiddenOverlayButtonStyle" TargetType="Button" BasedOn="{StaticResource OverlayButtonStyle}">
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>

        <Style x:Key="AnnotationToolButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#3C4250" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Host"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Host" Property="Background" Value="#14000000" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Host" Property="Background" Value="#22000000" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.32" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource AnnotationToolButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Host"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Host" Property="Background" Value="#E63D5AF5" />
                                <Setter Property="Foreground" Value="#FFFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Host" Property="Background" Value="#CC2F49D6" />
                                <Setter Property="Foreground" Value="#FFFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ColorSwatchStyle" TargetType="Button">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Ring"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="2"
                                CornerRadius="12"
                                Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Background" Value="#14000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    <Style x:Key="OptionStepButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#3C4250" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Host"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Host" Property="Background" Value="#14000000" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Host" Property="Background" Value="#22000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root"
          Background="Transparent"
          Focusable="True"
          ClipToBounds="True"
          PreviewMouseLeftButtonDown="Root_PreviewMouseLeftButtonDown"
          PreviewMouseMove="Root_PreviewMouseMove"
          PreviewMouseLeftButtonUp="Root_PreviewMouseLeftButtonUp"
          PreviewMouseRightButtonDown="Root_PreviewMouseRightButtonDown"
          MouseLeave="Root_MouseLeave">
        <Image x:Name="FrozenImage"
               Stretch="Fill"
               IsHitTestVisible="False"
               RenderOptions.BitmapScalingMode="HighQuality" />

        <Canvas x:Name="AnnotationLayer" IsHitTestVisible="False" ClipToBounds="True">
            <local:AnnotationCanvas x:Name="AnnotationView"
                                    IsHitTestVisible="False"
                                    ClipToBounds="True" />
        </Canvas>

        <Canvas x:Name="ChromeLayer" IsHitTestVisible="False" ClipToBounds="True">
            <Rectangle x:Name="DimFull" Fill="#A6000000" />
            <Rectangle x:Name="DimTop" Fill="#A6000000" Visibility="Collapsed" />
            <Rectangle x:Name="DimBottom" Fill="#A6000000" Visibility="Collapsed" />
            <Rectangle x:Name="DimLeft" Fill="#A6000000" Visibility="Collapsed" />
            <Rectangle x:Name="DimRight" Fill="#A6000000" Visibility="Collapsed" />

            <Rectangle x:Name="CrossVertical"
                       Width="1"
                       Fill="#8CFFFFFF"
                       Visibility="Collapsed" />
            <Rectangle x:Name="CrossHorizontal"
                       Height="1"
                       Fill="#8CFFFFFF"
                       Visibility="Collapsed" />

            <Border x:Name="SelectionBorder"
                    BorderThickness="1.5"
                    BorderBrush="#FF7CA8FF"
                    Background="Transparent"
                    Visibility="Collapsed" />

            <Rectangle x:Name="CornerTopLeft" Width="7" Height="7" Fill="#FF7CA8FF" Visibility="Collapsed" />
            <Rectangle x:Name="CornerTopRight" Width="7" Height="7" Fill="#FF7CA8FF" Visibility="Collapsed" />
            <Rectangle x:Name="CornerBottomLeft" Width="7" Height="7" Fill="#FF7CA8FF" Visibility="Collapsed" />
            <Rectangle x:Name="CornerBottomRight" Width="7" Height="7" Fill="#FF7CA8FF" Visibility="Collapsed" />
            <Rectangle x:Name="EdgeTop" Width="7" Height="7" Fill="#FF7CA8FF" Visibility="Collapsed" />
            <Rectangle x:Name="EdgeBottom" Width="7" Height="7" Fill="#FF7CA8FF" Visibility="Collapsed" />
            <Rectangle x:Name="EdgeLeft" Width="7" Height="7" Fill="#FF7CA8FF" Visibility="Collapsed" />
            <Rectangle x:Name="EdgeRight" Width="7" Height="7" Fill="#FF7CA8FF" Visibility="Collapsed" />

            <Rectangle x:Name="ElementBorder"
                       StrokeThickness="1.5"
                       Stroke="#FF7CA8FF"
                       Fill="Transparent"
                       Visibility="Collapsed" />
        </Canvas>

        <Grid x:Name="Magnifier"
              Width="136"
              HorizontalAlignment="Left"
              VerticalAlignment="Top"
              IsHitTestVisible="False"
              Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="136" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    CornerRadius="10"
                    Background="#FF0B0F16">
                <Border.Effect>
                    <DropShadowEffect Color="#FF000000" BlurRadius="18" ShadowDepth="3" Opacity="0.42" />
                </Border.Effect>
                <Grid x:Name="MagnifierViewport" Width="136" Height="136">
                    <Grid.Clip>
                        <RectangleGeometry Rect="0,0,136,136" RadiusX="9" RadiusY="9" />
                    </Grid.Clip>
                    <Image x:Name="MagnifierImage"
                           Width="136"
                           Height="136"
                           Stretch="Fill"
                           RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    <Canvas IsHitTestVisible="False">
                        <Rectangle x:Name="MagnifierPixelRing"
                                   Width="9"
                                   Height="9"
                                   Stroke="#FF7CA8FF"
                                   StrokeThickness="1.5"
                                   Canvas.Left="63.5"
                                   Canvas.Top="63.5" />
                    </Canvas>
                    <Border CornerRadius="10"
                            BorderBrush="#5CFFFFFF"
                            BorderThickness="1"
                            IsHitTestVisible="False" />
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Margin="0,5,0,0"
                    Padding="8,6"
                    CornerRadius="8"
                    Background="#F210141C"
                    BorderBrush="#33FFFFFF"
                    BorderThickness="1">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="MagnifierSwatch"
                                Width="11"
                                Height="11"
                                CornerRadius="3"
                                Background="#FFFFFFFF"
                                BorderBrush="#4DFFFFFF"
                                BorderThickness="1"
                                VerticalAlignment="Center" />
                        <TextBlock x:Name="MagnifierHex"
                                   Margin="7,0,0,0"
                                   FontFamily="Consolas, Microsoft YaHei UI"
                                   FontSize="11"
                                   Foreground="#E8EDF6"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="MagnifierCoord"
                               Margin="0,3,0,0"
                               FontFamily="Consolas, Microsoft YaHei UI"
                               FontSize="10"
                               Foreground="#8D9AAF" />
                </StackPanel>
            </Border>
        </Grid>

        <Canvas x:Name="EditorLayer" ClipToBounds="True" />

        <Border x:Name="HintChip"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,26,0,0"
                Padding="13,9"
                CornerRadius="10"
                Background="#E612161E"
                BorderBrush="#2AFFFFFF"
                BorderThickness="1"
                IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect Color="#FF000000" BlurRadius="18" ShadowDepth="4" Opacity="0.45" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="HintDot"
                         Width="6"
                         Height="6"
                         Fill="#FF7CA8FF"
                         VerticalAlignment="Center"
                         Margin="0,0,9,0" />
                <TextBlock x:Name="HintText"
                           FontSize="11.5"
                           Foreground="#D8E0EC"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <Border x:Name="SizeBadge"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Padding="8,4"
                CornerRadius="6"
                Background="#E610141C"
                BorderBrush="#38FFFFFF"
                BorderThickness="1"
                Visibility="Collapsed"
                IsHitTestVisible="False">
            <TextBlock x:Name="SizeText"
                       FontFamily="Consolas, Microsoft YaHei UI"
                       FontSize="11"
                       Foreground="#ECF2FA" />
        </Border>

        <Border x:Name="Toolbar"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Padding="4"
                CornerRadius="10"
                Background="#FAF8F9FB"
                BorderBrush="#22000000"
                BorderThickness="1"
                Visibility="Collapsed"
                Cursor="Arrow">
            <Border.Effect>
                <DropShadowEffect Color="#FF000000" BlurRadius="24" ShadowDepth="5" Opacity="0.28" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <StackPanel x:Name="ToolGroup" Orientation="Horizontal">
                    <Button x:Name="ToolSelectButton"
                            AutomationProperties.AutomationId="tool.select"
                            Style="{StaticResource AnnotationToolButtonStyle}"
                            Tag="Select"
                            ToolTip="选择 / 移动 (V)"
                            AutomationProperties.Name="选择"
                            Click="AnnotationTool_Click">
                        <Viewbox Width="16" Height="16">
                            <Path Style="{StaticResource OverlayIconStyle}"
                                  Data="M5 3l14 9-6 1.6L9.6 21 5 3Z" />
                        </Viewbox>
                    </Button>

                    <Border Width="1" Margin="4,7" Background="#1A000000" />

                    <Button x:Name="ToolRectangleButton"
                            AutomationProperties.AutomationId="tool.rectangle"
                            Style="{StaticResource AnnotationToolButtonStyle}"
                            Tag="Rectangle"
                            ToolTip="矩形 (R) · Shift 正方形"
                            AutomationProperties.Name="矩形"
                            Click="AnnotationTool_Click">
                        <Viewbox Width="16" Height="16">
                            <Path Style="{StaticResource OverlayIconStyle}" Data="M4 5h16v14H4Z" />
                        </Viewbox>
                    </Button>
                    <Button x:Name="ToolEllipseButton"
                            AutomationProperties.AutomationId="tool.ellipse"
                            Style="{StaticResource AnnotationToolButtonStyle}"
                            Tag="Ellipse"
                            ToolTip="椭圆 (E) · Shift 正圆"
                            AutomationProperties.Name="椭圆"
                            Click="AnnotationTool_Click">
                        <Viewbox Width="16" Height="16">
                            <Path Style="{StaticResource OverlayIconStyle}"
                                  Data="M12 5c4.4 0 8 3.1 8 7s-3.6 7-8 7-8-3.1-8-7 3.6-7 8-7Z" />
                        </Viewbox>
                    </Button>
                    <Button x:Name="ToolArrowButton"
                            AutomationProperties.AutomationId="tool.arrow"
                            Style="{StaticResource AnnotationToolButtonStyle}"
                            Tag="Arrow"
                            ToolTip="箭头 (A) · Shift 锁定角度"
                            AutomationProperties.Name="箭头"
                            Click="AnnotationTool_Click">
                        <Viewbox Width="16" Height="16">
                            <Path Style="{StaticResource OverlayIconStyle}" Data="M5 19L19 5 M11 5h8v8" />
                        </Viewbox>
                    </Button>

                    <Border Width="1" Margin="4,7" Background="#1A000000" />

                    <Button x:Name="ToolPenButton"
                            AutomationProperties.AutomationId="tool.pen"
                            Style="{StaticResource AnnotationToolButtonStyle}"
                            Tag="Pen"
                            ToolTip="画笔 (P) · 滚轮调粗细"
                            AutomationProperties.Name="画笔"
                            Click="AnnotationTool_Click">
                        <Viewbox Width="16" Height="16">
                            <Path Style="{StaticResource OverlayIconStyle}"
                                  Data="M4 20l4-1 10-10-3-3L5 16l-1 4Z M14 6l4 4" />
                        </Viewbox>
                    </Button>
                    <Button x:Name="ToolTextButton"
                            AutomationProperties.AutomationId="tool.text"
                            Style="{StaticResource AnnotationToolButtonStyle}"
                            Tag="Text"
                            ToolTip="文字 (T) · 滚轮调字号"
                            AutomationProperties.Name="文字"
                            Click="AnnotationTool_Click">
                        <Viewbox Width="16" Height="16">
                            <Path Style="{StaticResource OverlayIconStyle}" Data="M5 6V4h14v2 M12 4v16 M9 20h6" />
                        </Viewbox>
                    </Button>
                    <Button x:Name="ToolHighlighterButton"
                            AutomationProperties.AutomationId="tool.highlighter"
                            Style="{StaticResource AnnotationToolButtonStyle}"
                            Tag="Highlighter"
                            ToolTip="荧光笔 (H) · 滚轮调粗细"
                            AutomationProperties.Name="荧光笔"
                            Click="AnnotationTool_Click">
                        <Viewbox Width="16" Height="16">
                            <Path Style="{StaticResource OverlayIconStyle}"
                                  Data="M6 20h12 M8 16l-2 2 M8 16l8-9 3 3-8 9H8Z" />
                        </Viewbox>
                    </Button>
                    <Button x:Name="ToolMosaicButton"
                            AutomationProperties.AutomationId="tool.mosaic"
                            Style="{StaticResource AnnotationToolButtonStyle}"
                            Tag="Mosaic"
                            ToolTip="马赛克 (M) · 滚轮调密度"
                            AutomationProperties.Name="马赛克"
                            Click="AnnotationTool_Click">
                        <Viewbox Width="16" Height="16">
                            <Path Style="{StaticResource OverlayIconStyle}"
                                  Data="M4 4h6v6H4Z M14 4h6v6h-6Z M4 14h6v6H4Z M14 14h6v6h-6Z" />
                        </Viewbox>
                    </Button>
                    <Button x:Name="ToolEraserButton"
                            AutomationProperties.AutomationId="tool.eraser"
                            Style="{StaticResource AnnotationToolButtonStyle}"
                            Tag="Eraser"
                            ToolTip="橡皮擦 (X) · 滚轮调大小 · 划过删除整条标注"
                            AutomationProperties.Name="橡皮擦"
                            Click="AnnotationTool_Click">
                        <Viewbox Width="16" Height="16">
                            <Path Style="{StaticResource OverlayIconStyle}"
                                  Data="M4 20h16 M7 17.5L14 7l4 3.2-7 10H7v-2.7Z M11 12l4 3.2" />
                        </Viewbox>
                    </Button>
                    <Button x:Name="ToolStepButton"
                            AutomationProperties.AutomationId="tool.step"
                            Style="{StaticResource AnnotationToolButtonStyle}"
                            Tag="Step"
                            ToolTip="序号 (N)"
                            AutomationProperties.Name="序号"
                            Click="AnnotationTool_Click">
                        <Viewbox Width="16" Height="16">
                            <Path Style="{StaticResource OverlayIconStyle}"
                                  Data="M12 3.5a8.5 8.5 0 1 1 0 17 8.5 8.5 0 0 1 0-17Z M10.5 9l1.7-1.3V16 M9.8 16h4.6" />
                        </Viewbox>
                    </Button>
                </StackPanel>

                <Border x:Name="HistorySeparator" Width="1" Margin="4,7" Background="#1A000000" />

                <StackPanel x:Name="HistoryGroup" Orientation="Horizontal">
                    <Button x:Name="UndoButton"
                            AutomationProperties.AutomationId="history.undo"
                            Style="{StaticResource AnnotationToolButtonStyle}"
                            Tag="Undo"
                            ToolTip="撤销 (Ctrl+Z)"
                            AutomationProperties.Name="撤销"
                            Click="AnnotationAction_Click">
                        <Viewbox Width="15" Height="15">
                            <Path Style="{StaticResource OverlayIconStyle}"
                                  Data="M9 6L4 11l5 5 M4 11h9a5 5 0 0 1 5 5v2" />
                        </Viewbox>
                    </Button>
                    <Button x:Name="RedoButton"
                            AutomationProperties.AutomationId="history.redo"
                            Style="{StaticResource AnnotationToolButtonStyle}"
                            Tag="Redo"
                            ToolTip="重做 (Ctrl+Y)"
                            AutomationProperties.Name="重做"
                            Click="AnnotationAction_Click">
                        <Viewbox Width="15" Height="15">
                            <Path Style="{StaticResource OverlayIconStyle}"
                                  Data="M15 6l5 5-5 5 M20 11h-9a5 5 0 0 0-5 5v2" />
                        </Viewbox>
                    </Button>
                    <Button x:Name="ClearButton"
                            AutomationProperties.AutomationId="history.clear"
                            Style="{StaticResource AnnotationToolButtonStyle}"
                            Tag="Clear"
                            ToolTip="清空标注"
                            AutomationProperties.Name="清空标注"
                            Click="AnnotationAction_Click">
                        <Viewbox Width="15" Height="15">
                            <Path Style="{StaticResource OverlayIconStyle}"
                                  Data="M5 7h14 M9 7V4h6v3 M7 7l1 13h8l1-13 M10 11v6 M14 11v6" />
                        </Viewbox>
                    </Button>
                </StackPanel>

                <Border x:Name="ActionSeparator" Width="1" Margin="4,7" Background="#1A000000" />

                <StackPanel x:Name="ActionGroup" Orientation="Horizontal">
                    <Button x:Name="PinButton"
                            AutomationProperties.AutomationId="action.pin"
                            Style="{StaticResource AnnotationToolButtonStyle}"
                            Tag="Pin"
                            ToolTip="贴图 (Ctrl+T)"
                            AutomationProperties.Name="贴图"
                            Click="ActionButton_Click">
                        <Viewbox Width="15" Height="15">
                            <Path Style="{StaticResource OverlayIconStyle}"
                                  Data="M9 4h6v5l3 3v2H6v-2l3-3V4Z M12 14v6" />
                        </Viewbox>
                    </Button>
                    <Button x:Name="CopyButton"
                            AutomationProperties.AutomationId="action.copy"
                            Style="{StaticResource AnnotationToolButtonStyle}"
                            Tag="Copy"
                            ToolTip="复制到剪贴板 (Enter)"
                            AutomationProperties.Name="复制"
                            Click="ActionButton_Click">
                        <Viewbox Width="15" Height="15">
                            <Path Style="{StaticResource OverlayIconStyle}"
                                  Data="M8 8h9a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1H8a1 1 0 0 1-1-1V9a1 1 0 0 1 1-1Z M5 16H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h11a1 1 0 0 1 1 1v1" />
                        </Viewbox>
                    </Button>
                    <Button x:Name="SaveButton"
                            AutomationProperties.AutomationId="action.save"
                            Style="{StaticResource AnnotationToolButtonStyle}"
                            Tag="Save"
                            ToolTip="保存为图片 (Ctrl+S)"
                            AutomationProperties.Name="保存"
                            Click="ActionButton_Click">
                        <Viewbox Width="15" Height="15">
                            <Path Style="{StaticResource OverlayIconStyle}"
                                  Data="M4 4h13l3 3v13H4V4Z M8 4v6h8V4 M8 20v-7h8v7" />
                        </Viewbox>
                    </Button>
                    <Button x:Name="OcrButton"
                            AutomationProperties.AutomationId="action.ocr"
                            Style="{StaticResource AnnotationToolButtonStyle}"
                            Tag="Ocr"
                            ToolTip="识别文字"
                            AutomationProperties.Name="OCR 识别"
                            Click="ActionButton_Click">
                        <Viewbox Width="15" Height="15">
                            <Path Style="{StaticResource OverlayIconStyle}"
                                  Data="M4 8V4h4 M16 4h4v4 M20 16v4h-4 M8 20H4v-4 M8 9h8 M8 12h8 M8 15h5" />
                        </Viewbox>
                    </Button>
                    <Button x:Name="StartRecordButton"
                            Style="{StaticResource HiddenOverlayButtonStyle}"
                            Tag="StartRecording"
                            ToolTip="开始录制 (Enter)"
                            AutomationProperties.Name="开始录制"
                            Click="ActionButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="9" Height="9" Fill="#FFFF6B6B" VerticalAlignment="Center" />
                            <TextBlock Text="开始录制" Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Border x:Name="CancelSeparator" Width="1" Margin="4,7" Background="#1A000000" />

                <Button x:Name="CancelButton"
                        AutomationProperties.AutomationId="action.cancel"
                        Style="{StaticResource CloseButtonStyle}"
                        Tag="Cancel"
                        ToolTip="取消 (Esc)"
                        AutomationProperties.Name="取消"
                        Click="ActionButton_Click">
                    <Viewbox Width="15" Height="15">
                        <Path Style="{StaticResource OverlayIconStyle}"
                              Data="M6 6l12 12 M18 6L6 18" />
                    </Viewbox>
                </Button>
            </StackPanel>
        </Border>

        <Border x:Name="OptionBar"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Padding="4"
                CornerRadius="10"
                Background="#FAF8F9FB"
                BorderBrush="#22000000"
                BorderThickness="1"
                Visibility="Collapsed"
                Cursor="Arrow">
            <Border.Effect>
                <DropShadowEffect Color="#FF000000" BlurRadius="20" ShadowDepth="4" Opacity="0.22" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <StackPanel x:Name="OptionColorGroup" Orientation="Horizontal">
                    <Button x:Name="ColorRedButton"
                            AutomationProperties.AutomationId="color.red"
                            Style="{StaticResource ColorSwatchStyle}"
                            Tag="#FFFF5A5A"
                            ToolTip="红色"
                            AutomationProperties.Name="红色"
                            Click="AnnotationColor_Click">
                        <Ellipse Width="12" Height="12" Fill="#FFFF5A5A" />
                    </Button>
                    <Button x:Name="ColorOrangeButton"
                            AutomationProperties.AutomationId="color.orange"
                            Style="{StaticResource ColorSwatchStyle}"
                            Tag="#FFFFA94D"
                            ToolTip="橙色"
                            AutomationProperties.Name="橙色"
                            Click="AnnotationColor_Click">
                        <Ellipse Width="12" Height="12" Fill="#FFFFA94D" />
                    </Button>
                    <Button x:Name="ColorYellowButton"
                            AutomationProperties.AutomationId="color.yellow"
                            Style="{StaticResource ColorSwatchStyle}"
                            Tag="#FFFFD166"
                            ToolTip="黄色"
                            AutomationProperties.Name="黄色"
                            Click="AnnotationColor_Click">
                        <Ellipse Width="12" Height="12" Fill="#FFFFD166" />
                    </Button>
                    <Button x:Name="ColorGreenButton"
                            AutomationProperties.AutomationId="color.green"
                            Style="{StaticResource ColorSwatchStyle}"
                            Tag="#FF7CE38B"
                            ToolTip="绿色"
                            AutomationProperties.Name="绿色"
                            Click="AnnotationColor_Click">
                        <Ellipse Width="12" Height="12" Fill="#FF7CE38B" />
                    </Button>
                    <Button x:Name="ColorBlueButton"
                            AutomationProperties.AutomationId="color.blue"
                            Style="{StaticResource ColorSwatchStyle}"
                            Tag="#FF6CA8FF"
                            ToolTip="蓝色"
                            AutomationProperties.Name="蓝色"
                            Click="AnnotationColor_Click">
                        <Ellipse Width="12" Height="12" Fill="#FF6CA8FF" />
                    </Button>
                    <Button x:Name="ColorPurpleButton"
                            AutomationProperties.AutomationId="color.purple"
                            Style="{StaticResource ColorSwatchStyle}"
                            Tag="#FFB08CFF"
                            ToolTip="紫色"
                            AutomationProperties.Name="紫色"
                            Click="AnnotationColor_Click">
                        <Ellipse Width="12" Height="12" Fill="#FFB08CFF" />
                    </Button>
                    <Button x:Name="ColorDarkButton"
                            AutomationProperties.AutomationId="color.dark"
                            Style="{StaticResource ColorSwatchStyle}"
                            Tag="#FF242933"
                            ToolTip="黑色"
                            AutomationProperties.Name="黑色"
                            Click="AnnotationColor_Click">
                        <Ellipse Width="12" Height="12" Fill="#FF242933" Stroke="#5CFFFFFF" StrokeThickness="1" />
                    </Button>
                    <Button x:Name="ColorWhiteButton"
                            AutomationProperties.AutomationId="color.white"
                            Style="{StaticResource ColorSwatchStyle}"
                            Tag="#FFFFFFFF"
                            ToolTip="白色"
                            AutomationProperties.Name="白色"
                            Click="AnnotationColor_Click">
                        <Ellipse Width="12" Height="12" Fill="#FFFFFFFF" Stroke="#26000000" StrokeThickness="1" />
                    </Button>
                </StackPanel>

                <Border x:Name="OptionColorSeparator" Width="1" Margin="4,6" Background="#1A000000" />

                <StackPanel x:Name="ShapeOptionGroup" Orientation="Horizontal">
                    <TextBlock Text="样式" FontSize="11" Foreground="#5A6270" Margin="6,0,5,0" VerticalAlignment="Center" />
                    <Button x:Name="ShapeOutlineButton"
                            AutomationProperties.AutomationId="option.outline"
                            Style="{StaticResource AnnotationToolButtonStyle}"
                            Tag="Outline"
                            ToolTip="空心形状 (F 切换)"
                            AutomationProperties.Name="空心形状"
                            Click="ShapeStyle_Click">
                        <Viewbox Width="16" Height="16">
                            <Path Style="{StaticResource OverlayIconStyle}" Data="M4 5h16v14H4Z" />
                        </Viewbox>
                    </Button>
                    <Button x:Name="ShapeFillButton"
                            AutomationProperties.AutomationId="option.fill"
                            Style="{StaticResource AnnotationToolButtonStyle}"
                            Tag="Fill"
                            ToolTip="实心填充 (F 切换)"
                            AutomationProperties.Name="实心填充"
                            Click="ShapeStyle_Click">
                        <Viewbox Width="16" Height="16">
                            <Path Style="{StaticResource OverlayIconStyle}"
                                  Data="M4 5h16v14H4Z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Viewbox>
                    </Button>
                </StackPanel>

                <StackPanel x:Name="BrushOptionGroup" Orientation="Horizontal">
                    <TextBlock Text="粗细" FontSize="11" Foreground="#5A6270" Margin="4,0,6,0" VerticalAlignment="Center" />
                    <Button Style="{StaticResource OptionStepButtonStyle}" AutomationProperties.AutomationId="option.down" Tag="Down" ToolTip="变细 (Ctrl+滚轮)" Content="−" Click="OptionStep_Click" />
                    <TextBlock x:Name="BrushValueText" Width="26" FontSize="11.5" Foreground="#2A303B" TextAlignment="Center" VerticalAlignment="Center" />
                    <Button Style="{StaticResource OptionStepButtonStyle}" AutomationProperties.AutomationId="option.up" Tag="Up" ToolTip="变粗 (Ctrl+滚轮)" Content="+" Click="OptionStep_Click" />
                </StackPanel>

                <StackPanel x:Name="ArrowOptionGroup" Orientation="Horizontal">
                    <TextBlock Text="箭头" FontSize="11" Foreground="#5A6270" Margin="6,0,5,0" VerticalAlignment="Center" />
                    <Button x:Name="ArrowEndButton"
                            AutomationProperties.AutomationId="option.arrowEnd"
                            Style="{StaticResource AnnotationToolButtonStyle}"
                            Tag="End"
                            ToolTip="末端箭头"
                            AutomationProperties.Name="末端箭头"
                            Click="ArrowStyle_Click">
                        <Viewbox Width="16" Height="16">
                            <Path Style="{StaticResource OverlayIconStyle}" Data="M4 12h14 M12 6l6 6-6 6" />
                        </Viewbox>
                    </Button>
                    <Button x:Name="ArrowBothButton"
                            AutomationProperties.AutomationId="option.arrowBoth"
                            Style="{StaticResource AnnotationToolButtonStyle}"
                            Tag="Both"
                            ToolTip="双向箭头"
                            AutomationProperties.Name="双向箭头"
                            Click="ArrowStyle_Click">
                        <Viewbox Width="16" Height="16">
                            <Path Style="{StaticResource OverlayIconStyle}"
                                  Data="M4 12h16 M4 12l5-5 M4 12l5 5 M20 12l-5-5 M20 12l-5 5" />
                        </Viewbox>
                    </Button>
                    <Button x:Name="ArrowLineButton"
                            AutomationProperties.AutomationId="option.arrowLine"
                            Style="{StaticResource AnnotationToolButtonStyle}"
                            Tag="None"
                            ToolTip="直线（无箭头）"
                            AutomationProperties.Name="直线"
                            Click="ArrowStyle_Click">
                        <Viewbox Width="16" Height="16">
                            <Path Style="{StaticResource OverlayIconStyle}" Data="M4 12h16" />
                        </Viewbox>
                    </Button>
                </StackPanel>

                <StackPanel x:Name="TextOptionGroup" Orientation="Horizontal">
                    <TextBlock Text="字号" FontSize="11" Foreground="#5A6270" Margin="4,0,6,0" VerticalAlignment="Center" />
                    <Button Style="{StaticResource OptionStepButtonStyle}" Tag="Down" ToolTip="变小 (滚轮)" Content="−" Click="OptionStep_Click" />
                    <TextBlock x:Name="TextValueText" Width="26" FontSize="11.5" Foreground="#2A303B" TextAlignment="Center" VerticalAlignment="Center" />
                    <Button Style="{StaticResource OptionStepButtonStyle}" Tag="Up" ToolTip="变大 (滚轮)" Content="+" Click="OptionStep_Click" />
                </StackPanel>

                <StackPanel x:Name="TextStyleOptionGroup" Orientation="Horizontal">
                    <Button x:Name="BoldToggleButton"
                            AutomationProperties.AutomationId="option.bold"
                            Style="{StaticResource AnnotationToolButtonStyle}"
                            Tag="Bold"
                            ToolTip="加粗 (Ctrl+B)"
                            AutomationProperties.Name="加粗"
                            Click="TextStyle_Click">
                        <TextBlock Text="B"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button x:Name="ItalicToggleButton"
                            AutomationProperties.AutomationId="option.italic"
                            Style="{StaticResource AnnotationToolButtonStyle}"
                            Tag="Italic"
                            ToolTip="斜体 (Ctrl+I)"
                            AutomationProperties.Name="斜体"
                            Click="TextStyle_Click">
                        <TextBlock Text="I"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   FontStyle="Italic"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                </StackPanel>

                <StackPanel x:Name="MosaicOptionGroup" Orientation="Horizontal">
                    <TextBlock Text="密度" FontSize="11" Foreground="#5A6270" Margin="4,0,6,0" VerticalAlignment="Center" />
                    <Button Style="{StaticResource OptionStepButtonStyle}" Tag="Down" ToolTip="更密 (滚轮)" Content="−" Click="OptionStep_Click" />
                    <TextBlock x:Name="MosaicValueText" Width="26" FontSize="11.5" Foreground="#2A303B" TextAlignment="Center" VerticalAlignment="Center" />
                    <Button Style="{StaticResource OptionStepButtonStyle}" Tag="Up" ToolTip="更疏 (滚轮)" Content="+" Click="OptionStep_Click" />
                </StackPanel>

                <StackPanel x:Name="EraserOptionGroup" Orientation="Horizontal">
                    <TextBlock Text="大小" FontSize="11" Foreground="#5A6270" Margin="4,0,6,0" VerticalAlignment="Center" />
                    <Button Style="{StaticResource OptionStepButtonStyle}" Tag="Down" ToolTip="变小 (滚轮)" Content="−" Click="OptionStep_Click" />
                    <TextBlock x:Name="EraserValueText" Width="26" FontSize="11.5" Foreground="#2A303B" TextAlignment="Center" VerticalAlignment="Center" />
                    <Button Style="{StaticResource OptionStepButtonStyle}" Tag="Up" ToolTip="变大 (滚轮)" Content="+" Click="OptionStep_Click" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border x:Name="ToolHud"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Padding="9,5"
                CornerRadius="7"
                Background="#FAF8F9FB"
                BorderBrush="#22000000"
                BorderThickness="1"
                Visibility="Collapsed"
                Opacity="0"
                IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect Color="#FF000000" BlurRadius="14" ShadowDepth="3" Opacity="0.22" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="ToolHudDot"
                         Width="6"
                         Height="6"
                         Fill="#FF2F7CF6"
                         VerticalAlignment="Center"
                         Margin="0,0,7,0" />
                <TextBlock x:Name="ToolHudText"
                           FontSize="11"
                           Foreground="#2A303B"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
