<Window x:Class="HaloCap.UI.ScreenshotOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HaloCap.UI"
        Title="HaloCap 选区"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        SnapsToDevicePixels="True"
        UseLayoutRounding="False"
        FontFamily="{StaticResource AppFont}"
        Cursor="Cross"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <Style x:Key="OverlayButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#E8EDF6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="9,7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Host"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Host" Property="Background" Value="#1FFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Host" Property="Background" Value="#12FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OverlayIconStyle" TargetType="Path">
            <Setter Property="Stroke" Value="#DCE4F1" />
            <Setter Property="StrokeThickness" Value="1.35" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="Width" Value="15" />
            <Setter Property="Height" Value="15" />
        </Style>

        <Style x:Key="HiddenOverlayButtonStyle" TargetType="Button" BasedOn="{StaticResource OverlayButtonStyle}">
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>

        <Style x:Key="AnnotationToolButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Host"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Host" Property="Background" Value="#1FFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ColorSwatchStyle" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Ring"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="2"
                                CornerRadius="13"
                                Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Background" Value="#22FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root"
          Background="Transparent"
          Focusable="True"
          ClipToBounds="True"
          PreviewMouseLeftButtonDown="Root_PreviewMouseLeftButtonDown"
          PreviewMouseMove="Root_PreviewMouseMove"
          PreviewMouseLeftButtonUp="Root_PreviewMouseLeftButtonUp"
          PreviewMouseRightButtonDown="Root_PreviewMouseRightButtonDown"
          MouseLeave="Root_MouseLeave">
        <Image x:Name="FrozenImage"
               Stretch="Fill"
               IsHitTestVisible="False"
               RenderOptions.BitmapScalingMode="HighQuality" />

        <Canvas x:Name="AnnotationLayer" IsHitTestVisible="False" ClipToBounds="True">
            <local:AnnotationCanvas x:Name="AnnotationView"
                                    IsHitTestVisible="False"
                                    ClipToBounds="True" />
        </Canvas>

        <Canvas x:Name="ChromeLayer" IsHitTestVisible="False" ClipToBounds="True">
            <Rectangle x:Name="DimFull" Fill="#A6000000" />
            <Rectangle x:Name="DimTop" Fill="#A6000000" Visibility="Collapsed" />
            <Rectangle x:Name="DimBottom" Fill="#A6000000" Visibility="Collapsed" />
            <Rectangle x:Name="DimLeft" Fill="#A6000000" Visibility="Collapsed" />
            <Rectangle x:Name="DimRight" Fill="#A6000000" Visibility="Collapsed" />

            <Rectangle x:Name="CrossVertical"
                       Width="1"
                       Fill="#8CFFFFFF"
                       Visibility="Collapsed" />
            <Rectangle x:Name="CrossHorizontal"
                       Height="1"
                       Fill="#8CFFFFFF"
                       Visibility="Collapsed" />

            <Border x:Name="SelectionBorder"
                    BorderThickness="1.5"
                    BorderBrush="#FF7CA8FF"
                    Background="Transparent"
                    Visibility="Collapsed" />

            <Rectangle x:Name="CornerTopLeft" Width="7" Height="7" Fill="#FF7CA8FF" Visibility="Collapsed" />
            <Rectangle x:Name="CornerTopRight" Width="7" Height="7" Fill="#FF7CA8FF" Visibility="Collapsed" />
            <Rectangle x:Name="CornerBottomLeft" Width="7" Height="7" Fill="#FF7CA8FF" Visibility="Collapsed" />
            <Rectangle x:Name="CornerBottomRight" Width="7" Height="7" Fill="#FF7CA8FF" Visibility="Collapsed" />
            <Rectangle x:Name="EdgeTop" Width="7" Height="7" Fill="#FF7CA8FF" Visibility="Collapsed" />
            <Rectangle x:Name="EdgeBottom" Width="7" Height="7" Fill="#FF7CA8FF" Visibility="Collapsed" />
            <Rectangle x:Name="EdgeLeft" Width="7" Height="7" Fill="#FF7CA8FF" Visibility="Collapsed" />
            <Rectangle x:Name="EdgeRight" Width="7" Height="7" Fill="#FF7CA8FF" Visibility="Collapsed" />

            <Rectangle x:Name="ElementBorder"
                       StrokeThickness="1.5"
                       Stroke="#FF7CA8FF"
                       Fill="Transparent"
                       Visibility="Collapsed" />
        </Canvas>

        <Grid x:Name="Magnifier"
              Width="136"
              HorizontalAlignment="Left"
              VerticalAlignment="Top"
              IsHitTestVisible="False"
              Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="136" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    CornerRadius="10"
                    Background="#FF0B0F16">
                <Border.Effect>
                    <DropShadowEffect Color="#FF000000" BlurRadius="18" ShadowDepth="3" Opacity="0.42" />
                </Border.Effect>
                <Grid x:Name="MagnifierViewport" Width="136" Height="136">
                    <Grid.Clip>
                        <RectangleGeometry Rect="0,0,136,136" RadiusX="9" RadiusY="9" />
                    </Grid.Clip>
                    <Image x:Name="MagnifierImage"
                           Width="136"
                           Height="136"
                           Stretch="Fill"
                           RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    <Canvas IsHitTestVisible="False">
                        <Rectangle x:Name="MagnifierPixelRing"
                                   Width="9"
                                   Height="9"
                                   Stroke="#FF7CA8FF"
                                   StrokeThickness="1.5"
                                   Canvas.Left="63.5"
                                   Canvas.Top="63.5" />
                    </Canvas>
                    <Border CornerRadius="10"
                            BorderBrush="#5CFFFFFF"
                            BorderThickness="1"
                            IsHitTestVisible="False" />
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Margin="0,5,0,0"
                    Padding="8,6"
                    CornerRadius="8"
                    Background="#F210141C"
                    BorderBrush="#33FFFFFF"
                    BorderThickness="1">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="MagnifierSwatch"
                                Width="11"
                                Height="11"
                                CornerRadius="3"
                                Background="#FFFFFFFF"
                                BorderBrush="#4DFFFFFF"
                                BorderThickness="1"
                                VerticalAlignment="Center" />
                        <TextBlock x:Name="MagnifierHex"
                                   Margin="7,0,0,0"
                                   FontFamily="Consolas, Microsoft YaHei UI"
                                   FontSize="11"
                                   Foreground="#E8EDF6"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="MagnifierCoord"
                               Margin="0,3,0,0"
                               FontFamily="Consolas, Microsoft YaHei UI"
                               FontSize="10"
                               Foreground="#8D9AAF" />
                </StackPanel>
            </Border>
        </Grid>

        <Canvas x:Name="EditorLayer" ClipToBounds="True" />

        <Border x:Name="HintChip"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,26,0,0"
                Padding="13,9"
                CornerRadius="10"
                Background="#E612161E"
                BorderBrush="#2AFFFFFF"
                BorderThickness="1"
                IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect Color="#FF000000" BlurRadius="18" ShadowDepth="4" Opacity="0.45" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="HintDot"
                         Width="6"
                         Height="6"
                         Fill="#FF7CA8FF"
                         VerticalAlignment="Center"
                         Margin="0,0,9,0" />
                <TextBlock x:Name="HintText"
                           FontSize="11.5"
                           Foreground="#D8E0EC"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <Border x:Name="SizeBadge"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Padding="8,4"
                CornerRadius="6"
                Background="#E610141C"
                BorderBrush="#38FFFFFF"
                BorderThickness="1"
                Visibility="Collapsed"
                IsHitTestVisible="False">
            <TextBlock x:Name="SizeText"
                       FontFamily="Consolas, Microsoft YaHei UI"
                       FontSize="11"
                       Foreground="#ECF2FA" />
        </Border>

        <Border x:Name="Toolbar"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Padding="5"
                CornerRadius="13"
                Background="#F211151D"
                BorderBrush="#30FFFFFF"
                BorderThickness="1"
                Visibility="Collapsed"
                Cursor="Arrow">
            <Border.Effect>
                <DropShadowEffect Color="#FF000000" BlurRadius="26" ShadowDepth="7" Opacity="0.55" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="AnnotateButton"
                        Style="{StaticResource OverlayButtonStyle}"
                        ToolTip="标注 (Space)"
                        AutomationProperties.Name="标注"
                        Click="AnnotateButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="15" Height="15">
                            <Path Style="{StaticResource OverlayIconStyle}"
                                  Data="M4 20l4-1 10-10-3-3L5 16l-1 4Z M14 6l4 4" />
                        </Viewbox>
                        <TextBlock Text="标注" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button x:Name="PinButton"
                        Style="{StaticResource OverlayButtonStyle}"
                        Tag="Pin"
                        ToolTip="贴图 (4)"
                        AutomationProperties.Name="贴图"
                        Click="ActionButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="15" Height="15">
                            <Path Style="{StaticResource OverlayIconStyle}"
                                  Data="M9 4h6v5l3 3v2H6v-2l3-3V4Z M12 14v6" />
                        </Viewbox>
                        <TextBlock Text="贴图" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button x:Name="CopyButton"
                        Style="{StaticResource OverlayButtonStyle}"
                        Tag="Copy"
                        ToolTip="复制到剪贴板 (Enter)"
                        AutomationProperties.Name="复制"
                        Click="ActionButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="15" Height="15">
                            <Path Style="{StaticResource OverlayIconStyle}"
                                  Data="M8 8h9a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1H8a1 1 0 0 1-1-1V9a1 1 0 0 1 1-1Z M5 16H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h11a1 1 0 0 1 1 1v1" />
                        </Viewbox>
                        <TextBlock Text="复制" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button x:Name="SaveButton"
                        Style="{StaticResource OverlayButtonStyle}"
                        Tag="Save"
                        ToolTip="保存为图片 (Ctrl+S)"
                        AutomationProperties.Name="保存"
                        Click="ActionButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="15" Height="15">
                            <Path Style="{StaticResource OverlayIconStyle}"
                                  Data="M4 4h13l3 3v13H4V4Z M8 4v6h8V4 M8 20v-7h8v7" />
                        </Viewbox>
                        <TextBlock Text="保存" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button x:Name="OcrButton"
                        Style="{StaticResource OverlayButtonStyle}"
                        Tag="Ocr"
                        ToolTip="识别文字 (2)"
                        AutomationProperties.Name="OCR 识别"
                        Click="ActionButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="15" Height="15">
                            <Path Style="{StaticResource OverlayIconStyle}"
                                  Data="M4 8V4h4 M16 4h4v4 M20 16v4h-4 M8 20H4v-4 M8 9h8 M8 12h8 M8 15h5" />
                        </Viewbox>
                        <TextBlock Text="OCR" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button x:Name="StartRecordButton"
                        Style="{StaticResource HiddenOverlayButtonStyle}"
                        Tag="StartRecording"
                        ToolTip="开始录制 (Enter)"
                        AutomationProperties.Name="开始录制"
                        Click="ActionButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="9" Height="9" Fill="#FFFF6B6B" VerticalAlignment="Center" />
                        <TextBlock Text="开始录制" Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Border x:Name="ToolbarSeparator"
                        Width="1"
                        Margin="4,7"
                        Background="#26FFFFFF" />

                <Button x:Name="CancelButton"
                        Style="{StaticResource OverlayButtonStyle}"
                        Tag="Cancel"
                        ToolTip="取消 (Esc)"
                        AutomationProperties.Name="取消"
                        Click="ActionButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="15" Height="15">
                            <Path Style="{StaticResource OverlayIconStyle}"
                                  Stroke="#AEB8C6"
                                  Data="M6 6l12 12 M18 6L6 18" />
                        </Viewbox>
                        <TextBlock Text="取消" Margin="6,0,0,0" Foreground="#AEB8C6" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <Border x:Name="AnnotationBar"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Padding="5"
                CornerRadius="12"
                Background="#F211151D"
                BorderBrush="#30FFFFFF"
                BorderThickness="1"
                Visibility="Collapsed"
                Cursor="Arrow">
            <Border.Effect>
                <DropShadowEffect Color="#FF000000" BlurRadius="24" ShadowDepth="6" Opacity="0.5" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="ToolPenButton"
                        Style="{StaticResource AnnotationToolButtonStyle}"
                        Tag="Pen"
                        ToolTip="画笔 (P)"
                        AutomationProperties.Name="画笔"
                        Click="AnnotationTool_Click">
                    <Viewbox Width="15" Height="15">
                        <Path Style="{StaticResource OverlayIconStyle}"
                              Data="M4 20l4-1 10-10-3-3L5 16l-1 4Z M14 6l4 4" />
                    </Viewbox>
                </Button>
                <Button x:Name="ToolRectangleButton"
                        Style="{StaticResource AnnotationToolButtonStyle}"
                        Tag="Rectangle"
                        ToolTip="矩形 (R)"
                        AutomationProperties.Name="矩形"
                        Click="AnnotationTool_Click">
                    <Viewbox Width="15" Height="15">
                        <Path Style="{StaticResource OverlayIconStyle}" Data="M4 5h16v14H4Z" />
                    </Viewbox>
                </Button>
                <Button x:Name="ToolEllipseButton"
                        Style="{StaticResource AnnotationToolButtonStyle}"
                        Tag="Ellipse"
                        ToolTip="椭圆 (E)"
                        AutomationProperties.Name="椭圆"
                        Click="AnnotationTool_Click">
                    <Viewbox Width="15" Height="15">
                        <Path Style="{StaticResource OverlayIconStyle}"
                              Data="M12 5c4.4 0 8 3.1 8 7s-3.6 7-8 7-8-3.1-8-7 3.6-7 8-7Z" />
                    </Viewbox>
                </Button>
                <Button x:Name="ToolArrowButton"
                        Style="{StaticResource AnnotationToolButtonStyle}"
                        Tag="Arrow"
                        ToolTip="箭头 (A)"
                        AutomationProperties.Name="箭头"
                        Click="AnnotationTool_Click">
                    <Viewbox Width="15" Height="15">
                        <Path Style="{StaticResource OverlayIconStyle}" Data="M5 19L19 5 M11 5h8v8" />
                    </Viewbox>
                </Button>
                <Button x:Name="ToolTextButton"
                        Style="{StaticResource AnnotationToolButtonStyle}"
                        Tag="Text"
                        ToolTip="文字 (T)"
                        AutomationProperties.Name="文字"
                        Click="AnnotationTool_Click">
                    <Viewbox Width="15" Height="15">
                        <Path Style="{StaticResource OverlayIconStyle}" Data="M5 6V4h14v2 M12 4v16 M9 20h6" />
                    </Viewbox>
                </Button>
                <Button x:Name="ToolHighlighterButton"
                        Style="{StaticResource AnnotationToolButtonStyle}"
                        Tag="Highlighter"
                        ToolTip="荧光笔 (H)"
                        AutomationProperties.Name="荧光笔"
                        Click="AnnotationTool_Click">
                    <Viewbox Width="15" Height="15">
                        <Path Style="{StaticResource OverlayIconStyle}"
                              Data="M6 20h12 M8 16l-2 2 M8 16l8-9 3 3-8 9H8Z" />
                    </Viewbox>
                </Button>

                <Border Width="1" Margin="4,6" Background="#26FFFFFF" />

                <Button x:Name="ColorRedButton"
                        Style="{StaticResource ColorSwatchStyle}"
                        Tag="#FFFF5A5A"
                        ToolTip="红色"
                        Click="AnnotationColor_Click">
                    <Ellipse Width="13" Height="13" Fill="#FFFF5A5A" />
                </Button>
                <Button x:Name="ColorYellowButton"
                        Style="{StaticResource ColorSwatchStyle}"
                        Tag="#FFFFD166"
                        ToolTip="黄色"
                        Click="AnnotationColor_Click">
                    <Ellipse Width="13" Height="13" Fill="#FFFFD166" />
                </Button>
                <Button x:Name="ColorGreenButton"
                        Style="{StaticResource ColorSwatchStyle}"
                        Tag="#FF7CE38B"
                        ToolTip="绿色"
                        Click="AnnotationColor_Click">
                    <Ellipse Width="13" Height="13" Fill="#FF7CE38B" />
                </Button>
                <Button x:Name="ColorBlueButton"
                        Style="{StaticResource ColorSwatchStyle}"
                        Tag="#FF6CA8FF"
                        ToolTip="蓝色"
                        Click="AnnotationColor_Click">
                    <Ellipse Width="13" Height="13" Fill="#FF6CA8FF" />
                </Button>
                <Button x:Name="ColorWhiteButton"
                        Style="{StaticResource ColorSwatchStyle}"
                        Tag="#FFFFFFFF"
                        ToolTip="白色"
                        Click="AnnotationColor_Click">
                    <Ellipse Width="13" Height="13" Fill="#FFFFFFFF" />
                </Button>

                <Border Width="1" Margin="4,6" Background="#26FFFFFF" />

                <Button x:Name="UndoButton"
                        Style="{StaticResource AnnotationToolButtonStyle}"
                        Tag="Undo"
                        ToolTip="撤销 (Ctrl+Z)"
                        AutomationProperties.Name="撤销"
                        Click="AnnotationAction_Click">
                    <Viewbox Width="15" Height="15">
                        <Path Style="{StaticResource OverlayIconStyle}"
                              Data="M9 6L4 11l5 5 M4 11h9a5 5 0 0 1 5 5v2" />
                    </Viewbox>
                </Button>
                <Button x:Name="RedoButton"
                        Style="{StaticResource AnnotationToolButtonStyle}"
                        Tag="Redo"
                        ToolTip="重做 (Ctrl+Y)"
                        AutomationProperties.Name="重做"
                        Click="AnnotationAction_Click">
                    <Viewbox Width="15" Height="15">
                        <Path Style="{StaticResource OverlayIconStyle}"
                              Data="M15 6l5 5-5 5 M20 11h-9a5 5 0 0 0-5 5v2" />
                    </Viewbox>
                </Button>
                <Button x:Name="ClearButton"
                        Style="{StaticResource AnnotationToolButtonStyle}"
                        Tag="Clear"
                        ToolTip="清空标注"
                        AutomationProperties.Name="清空标注"
                        Click="AnnotationAction_Click">
                    <Viewbox Width="15" Height="15">
                        <Path Style="{StaticResource OverlayIconStyle}"
                              Data="M5 7h14 M9 7V4h6v3 M7 7l1 13h8l1-13 M10 11v6 M14 11v6" />
                    </Viewbox>
                </Button>

                <Border Width="1" Margin="4,6" Background="#26FFFFFF" />

                <Button x:Name="DoneButton"
                        Style="{StaticResource OverlayButtonStyle}"
                        Tag="Done"
                        FontSize="11"
                        Padding="9,6"
                        Foreground="#8FBAFF"
                        Background="#267CA8FF"
                        ToolTip="退出标注 (Space)"
                        Click="AnnotationAction_Click"
                        Content="完成" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
