<Window x:Class="HaloCap.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="光圈 · 设置"
        Width="480"
        SizeToContent="Height"
        MaxHeight="700"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        FontFamily="{StaticResource AppFont}">
    <Window.Resources>
        <Style x:Key="FormatRadioStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Host"
                                Background="#0FFFFFFF"
                                BorderBrush="#22FFFFFF"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="13,8"
                                SnapsToDevicePixels="True">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="14" Height="14" VerticalAlignment="Center">
                                    <Ellipse x:Name="DotRing"
                                             Stroke="#FF7D8797"
                                             StrokeThickness="1.2" />
                                    <Ellipse x:Name="Dot"
                                             Width="6"
                                             Height="6"
                                             Fill="{StaticResource AccentBrush}"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"
                                             Visibility="Collapsed" />
                                </Grid>
                                <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Host" Property="Background" Value="#297CA8FF" />
                                <Setter TargetName="Host" Property="BorderBrush" Value="#667CA8FF" />
                                <Setter TargetName="DotRing" Property="Stroke" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Host" Property="BorderBrush" Value="#44FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PathTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#0FFFFFFF" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="#24FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="SelectionBrush" Value="#667CA8FF" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalScrollBarVisibility="Hidden" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="BorderBrush" Value="#667CA8FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Border CornerRadius="18" Background="#FF161A22">
            <Border.Effect>
                <DropShadowEffect Color="#FF000000"
                                  BlurRadius="34"
                                  ShadowDepth="8"
                                  Opacity="0.55" />
            </Border.Effect>
        </Border>

        <Border CornerRadius="18"
                Background="{StaticResource WindowBackgroundBrush}"
                BorderBrush="#22FFFFFF"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid x:Name="TitleBar"
                      Grid.Row="0"
                      Height="70"
                      Margin="22,0,14,0"
                      Background="Transparent"
                      MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Width="30" Height="30" VerticalAlignment="Center">
                        <Ellipse Stroke="#337CA8FF" StrokeThickness="1" />
                        <Ellipse Margin="4" Stroke="#FF7CA8FF" StrokeThickness="2" />
                        <Ellipse Width="6"
                                 Height="6"
                                 Fill="#FFF5B963"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center" />
                    </Grid>

                    <StackPanel Grid.Column="1"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center">
                        <TextBlock Text="光圈"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="HaloCap 设置"
                                   FontSize="10.5"
                                   Foreground="{StaticResource TextTertiaryBrush}"
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <Button Grid.Column="2"
                            Style="{StaticResource CloseButtonStyle}"
                            Content="✕"
                            FontFamily="Segoe UI"
                            ToolTip="关闭"
                            AutomationProperties.Name="关闭设置"
                            Click="CloseButton_Click" />
                </Grid>

                <ScrollViewer Grid.Row="1"
                              Margin="22,2,22,0"
                              MaxHeight="480"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Focusable="False">
                    <StackPanel Margin="0,0,6,2">
                        <Border Background="{StaticResource CardBackgroundBrush}"
                                BorderBrush="#14FFFFFF"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="18">
                            <StackPanel>
                                <TextBlock Text="全局快捷键"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="在任意应用中唤出，不打断当前输入"
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,5,0,0" />

                                <Button x:Name="HotkeyButton"
                                        Height="42"
                                        HorizontalAlignment="Stretch"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="0,14,0,0"
                                        ToolTip="点击后按下新的组合键"
                                        AutomationProperties.Name="修改全局快捷键"
                                        Click="HotkeyButton_Click">
                                    <TextBlock x:Name="HotkeyValueText"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                </Button>

                                <TextBlock x:Name="HotkeyHint"
                                           Text="点击上方输入框后按下组合键，Esc 取消"
                                           FontSize="10.5"
                                           Foreground="{StaticResource TextTertiaryBrush}"
                                           TextWrapping="Wrap"
                                           Margin="2,8,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource CardBackgroundBrush}"
                                BorderBrush="#14FFFFFF"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="18"
                                Margin="0,12,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="开机自动启动"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="登录 Windows 后自动在托盘运行"
                                               FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,5,12,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <TextBlock x:Name="AutoStartStatusText"
                                               Text="已关闭"
                                               FontSize="11"
                                               Foreground="{StaticResource TextTertiaryBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0" />
                                    <ToggleButton x:Name="AutoStartToggle"
                                                  Style="{StaticResource ToggleSwitchStyle}"
                                                  ToolTip="开启开机自启"
                                                  AutomationProperties.Name="开机自动启动" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Background="{StaticResource CardBackgroundBrush}"
                                BorderBrush="#14FFFFFF"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="18"
                                Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="截图格式"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="保存截图与另存贴图时使用的默认图片格式"
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,5,0,0" />

                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <RadioButton x:Name="PngRadio"
                                                 GroupName="ScreenshotFormat"
                                                 Content="PNG · 无损"
                                                 Style="{StaticResource FormatRadioStyle}"
                                                 Checked="FormatRadio_Checked" />
                                    <RadioButton x:Name="JpegRadio"
                                                 GroupName="ScreenshotFormat"
                                                 Content="JPG · 更小体积"
                                                 Style="{StaticResource FormatRadioStyle}"
                                                 Checked="FormatRadio_Checked" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource CardBackgroundBrush}"
                                BorderBrush="#14FFFFFF"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="18"
                                Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="录屏保存位置"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="支持绝对路径；留空则使用系统“视频”文件夹下的 Captures"
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,5,0,0" />

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBox x:Name="RecordingDirectoryBox"
                                             Height="38"
                                             Style="{StaticResource PathTextBoxStyle}"
                                             AutomationProperties.Name="录屏保存文件夹"
                                             TextChanged="RecordingDirectoryBox_TextChanged" />

                                    <Button Grid.Column="1"
                                            Content="浏览…"
                                            Width="82"
                                            Height="38"
                                            Margin="8,0,0,0"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="BrowseButton_Click" />
                                </Grid>

                                <TextBlock x:Name="RecordingDirectoryHint"
                                           FontSize="10.5"
                                           Foreground="{StaticResource TextTertiaryBrush}"
                                           TextWrapping="Wrap"
                                           Margin="2,8,0,0" />
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="ErrorText"
                                   Visibility="Collapsed"
                                   Foreground="{StaticResource DangerBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="2,12,2,2" />
                    </StackPanel>
                </ScrollViewer>

                <Grid Grid.Row="2" Margin="22,16,22,18">
                    <TextBlock Text="v1.0.0 · 本地离线处理"
                               FontSize="10.5"
                               Foreground="{StaticResource TextTertiaryBrush}"
                               VerticalAlignment="Center" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="取消"
                                Width="82"
                                Height="36"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="CancelButton_Click" />
                        <Button x:Name="SaveButton"
                                Content="保存"
                                Width="94"
                                Height="36"
                                Style="{StaticResource PrimaryButtonStyle}"
                                IsDefault="True"
                                Margin="10,0,0,0"
                                Click="SaveButton_Click" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
