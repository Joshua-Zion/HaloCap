<Window x:Class="HaloCap.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HaloCap 设置"
        Width="820"
        Height="620"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FF1D1D1F" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF6E6E73" />
        <SolidColorBrush x:Key="TextTertiaryBrush" Color="#FF8E8E93" />
        <SolidColorBrush x:Key="AccentBrush" Color="#FF007AFF" />

        <SolidColorBrush x:Key="SidebarBrush" Color="#FFEDEDF1" />
        <SolidColorBrush x:Key="ContentBrush" Color="#FFF7F7F9" />
        <SolidColorBrush x:Key="SettingsCardBrush" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="SettingsFieldBrush" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="SettingsHairlineBrush" Color="#14000000" />
        <SolidColorBrush x:Key="SettingsCardBorderBrush" Color="#FFE7E7EC" />
        <SolidColorBrush x:Key="SettingsFieldBorderBrush" Color="#FFD9D9DE" />

        <Style x:Key="PaneTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="21" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        </Style>

        <Style x:Key="PaneSubtitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="0,5,0,0" />
        </Style>

        <Style x:Key="GroupLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#FF86868B" />
            <Setter Property="Margin" Value="4,0,0,8" />
        </Style>

        <Style x:Key="SettingTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        </Style>

        <Style x:Key="SettingDescStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SettingsCardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SettingsCardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>

        <Style x:Key="RowDividerStyle" TargetType="Rectangle">
            <Setter Property="Height" Value="1" />
            <Setter Property="Fill" Value="{StaticResource SettingsHairlineBrush}" />
            <Setter Property="Margin" Value="16,0" />
        </Style>

        <Style x:Key="NavItemStyle" TargetType="RadioButton">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="#FF6E6E73" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Host"
                                Background="Transparent"
                                CornerRadius="8"
                                Padding="10,0"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="Glyph"
                                           Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="13"
                                           Foreground="#FF8E8E93"
                                           VerticalAlignment="Center" />
                                <ContentPresenter Grid.Column="1"
                                                  Margin="8,0,0,0"
                                                  VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Host" Property="Background" Value="#0A000000" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Host" Property="Background" Value="#FFE0E0E6" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowCloseButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTip" Value="关闭" />
            <Setter Property="AutomationProperties.Name" Value="关闭设置" />
            <Setter Property="Foreground" Value="#FF6E6E73" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Host"
                                Background="Transparent"
                                CornerRadius="7"
                                SnapsToDevicePixels="True">
                            <Path Width="16"
                                  Height="16"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="M4.5 4.5L11.5 11.5 M11.5 4.5L4.5 11.5"
                                  Stretch="Uniform"
                                  Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="1.4"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Host" Property="Background" Value="#14000000" />
                                <Setter Property="Foreground" Value="#FF1D1D1F" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Host" Property="Background" Value="#22000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SegmentOptionStyle" TargetType="RadioButton">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Host"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Host" Property="Background" Value="#FFEBEBEF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Host" Property="Background" Value="#FFFFFFFF" />
                                <Setter TargetName="Host" Property="BorderBrush" Value="#FFDCDCE1" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToggleSwitchStyle" TargetType="ToggleButton">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Width="44" Height="24" Background="Transparent">
                            <Border x:Name="Track"
                                    CornerRadius="12"
                                    Background="#FFE3E3E8"
                                    BorderBrush="#FFD5D5DB"
                                    BorderThickness="1" />
                            <Ellipse x:Name="Knob"
                                     Width="18"
                                     Height="18"
                                     Fill="#FFFFFFFF"
                                     HorizontalAlignment="Left"
                                     Margin="3,0,0,0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Knob" Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Track" Property="Opacity" Value="0.45" />
                                <Setter TargetName="Knob" Property="Opacity" Value="0.65" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="KeyFieldStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{StaticResource SettingsFieldBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SettingsFieldBorderBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Host"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="7"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Host" Property="Background" Value="#FFF7F7FA" />
                                <Setter TargetName="Host" Property="BorderBrush" Value="#FFC9C9CF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Host" Property="Background" Value="#FFEFEFF2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldTextBoxStyle" TargetType="TextBox">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Background" Value="{StaticResource SettingsFieldBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SettingsFieldBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="SelectionBrush" Value="#4D007AFF" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          VerticalScrollBarVisibility="Hidden" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FooterGhostButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Host"
                                Background="Transparent"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Host" Property="Background" Value="#0A000000" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Host" Property="Background" Value="#06000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FooterPrimaryButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="20,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#FFFFFFFF" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Host"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Host" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Host" Property="Opacity" Value="0.76" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Host" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                                  Opacity="0"
                                                  Focusable="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb MinHeight="28" Width="6" HorizontalAlignment="Center">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#33000000" CornerRadius="3" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                                  Opacity="0"
                                                  Focusable="False" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Border CornerRadius="18" Background="#FFFFFFFF">
            <Border.Effect>
                <DropShadowEffect Color="#FF000000"
                                  BlurRadius="32"
                                  ShadowDepth="8"
                                  Opacity="0.28" />
            </Border.Effect>
        </Border>

        <Border CornerRadius="18"
                Background="{StaticResource ContentBrush}"
                BorderBrush="#26000000"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="218" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid x:Name="WindowTitleBar"
                      Grid.Row="0"
                      Grid.ColumnSpan="2"
                      Background="Transparent"
                      MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Border x:Name="TitleBarBand"
                            Background="{StaticResource SidebarBrush}"
                            CornerRadius="17,17,0,0" />

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Margin="20,0,12,0">
                        <Grid Width="18" Height="18">
                            <Ellipse Stroke="#22000000" StrokeThickness="1" />
                            <Ellipse Margin="3" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.3" />
                            <Ellipse Width="3"
                                     Height="3"
                                     Fill="#FFF5B963"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="HaloCap"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="9,0,0,0" />
                        <TextBlock Text="光圈"
                                   FontSize="10.5"
                                   Foreground="{StaticResource TextTertiaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="7,1,0,0" />
                    </StackPanel>

                    <Button x:Name="WindowCloseButton"
                            Style="{StaticResource WindowCloseButtonStyle}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,14,0"
                            Click="CloseButton_Click" />

                    <Rectangle Height="1"
                               VerticalAlignment="Bottom"
                               Margin="218,0,0,0"
                               Fill="{StaticResource SettingsHairlineBrush}" />
                </Grid>

                <Border Grid.Row="1"
                        Grid.Column="0"
                        Background="{StaticResource SidebarBrush}"
                        BorderBrush="#0F000000"
                        BorderThickness="0,0,1,0"
                        CornerRadius="0,0,0,17" />

                <!-- 侧边栏 -->
                <Grid Grid.Row="1" Grid.Column="0">
                    <StackPanel Margin="18,14,14,0">
                        <RadioButton x:Name="NavGeneral"
                                     GroupName="SettingsNav"
                                     Uid="general"
                                     Tag="&#xE713;"
                                     Content="通用"
                                     Style="{StaticResource NavItemStyle}"
                                     Checked="NavItem_Checked" />
                        <RadioButton x:Name="NavCapture"
                                     GroupName="SettingsNav"
                                     Uid="capture"
                                     Tag="&#xE722;"
                                     Content="截图与贴图"
                                     Style="{StaticResource NavItemStyle}"
                                     Checked="NavItem_Checked" />
                        <RadioButton x:Name="NavRecording"
                                     GroupName="SettingsNav"
                                     Uid="recording"
                                     Tag="&#xE714;"
                                     Content="录屏"
                                     Style="{StaticResource NavItemStyle}"
                                     Checked="NavItem_Checked" />
                        <RadioButton x:Name="NavAbout"
                                     GroupName="SettingsNav"
                                     Uid="about"
                                     Tag="&#xE946;"
                                     Content="关于"
                                     Style="{StaticResource NavItemStyle}"
                                     Checked="NavItem_Checked" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1"
                        Grid.Column="1"
                        Background="{StaticResource ContentBrush}"
                        CornerRadius="0,0,17,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <!-- 通用 -->
                            <Grid x:Name="GeneralPane">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <StackPanel Margin="30,26,30,0"
                                            Background="Transparent"
                                            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                                    <TextBlock Text="通用" Style="{StaticResource PaneTitleStyle}" />
                                    <TextBlock Text="呼出方式、启动项与光圈外观"
                                               Style="{StaticResource PaneSubtitleStyle}" />
                                </StackPanel>

                                <ScrollViewer Grid.Row="1"
                                              Margin="30,20,30,0"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              Focusable="False">
                                    <StackPanel Margin="0,0,4,20">
                                        <TextBlock Text="快捷键" Style="{StaticResource GroupLabelStyle}" />
                                        <Border Style="{StaticResource CardStyle}">
                                            <StackPanel>
                                                <Border Padding="16,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Text="呼出光圈"
                                                                   Style="{StaticResource SettingTitleStyle}"
                                                                   VerticalAlignment="Center" />

                                                        <Button x:Name="RadialHotkeyButton"
                                                                Grid.Column="1"
                                                                Width="168"
                                                                Style="{StaticResource KeyFieldStyle}"
                                                                Tag="Radial"
                                                                ToolTip="单击后按下新的组合键"
                                                                AutomationProperties.AutomationId="settings.hotkey.radial"
                                                                AutomationProperties.Name="修改呼出光圈快捷键"
                                                                Click="HotkeyButton_Click">
                                                            <TextBlock x:Name="RadialHotkeyValueText"
                                                                       FontFamily="Consolas, Segoe UI"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource TextPrimaryBrush}" />
                                                        </Button>
                                                    </Grid>
                                                </Border>

                                                <Rectangle Style="{StaticResource RowDividerStyle}" />

                                                <Border Padding="16,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Text="截图"
                                                                   Style="{StaticResource SettingTitleStyle}"
                                                                   VerticalAlignment="Center" />

                                                        <Button x:Name="ScreenshotHotkeyButton"
                                                                Grid.Column="1"
                                                                Width="168"
                                                                Style="{StaticResource KeyFieldStyle}"
                                                                Tag="Screenshot"
                                                                ToolTip="单击后按下新的组合键"
                                                                AutomationProperties.AutomationId="settings.hotkey.screenshot"
                                                                AutomationProperties.Name="修改截图快捷键"
                                                                Click="HotkeyButton_Click">
                                                            <TextBlock x:Name="ScreenshotHotkeyValueText"
                                                                       FontFamily="Consolas, Segoe UI"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource TextPrimaryBrush}" />
                                                        </Button>
                                                    </Grid>
                                                </Border>

                                                <Rectangle Style="{StaticResource RowDividerStyle}" />

                                                <Border Padding="16,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Text="文字识别"
                                                                   Style="{StaticResource SettingTitleStyle}"
                                                                   VerticalAlignment="Center" />

                                                        <Button x:Name="OcrHotkeyButton"
                                                                Grid.Column="1"
                                                                Width="168"
                                                                Style="{StaticResource KeyFieldStyle}"
                                                                Tag="Ocr"
                                                                ToolTip="单击后按下新的组合键"
                                                                AutomationProperties.AutomationId="settings.hotkey.ocr"
                                                                AutomationProperties.Name="修改文字识别快捷键"
                                                                Click="HotkeyButton_Click">
                                                            <TextBlock x:Name="OcrHotkeyValueText"
                                                                       FontFamily="Consolas, Segoe UI"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource TextPrimaryBrush}" />
                                                        </Button>
                                                    </Grid>
                                                </Border>

                                                <Rectangle Style="{StaticResource RowDividerStyle}" />

                                                <Border Padding="16,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Text="录屏"
                                                                   Style="{StaticResource SettingTitleStyle}"
                                                                   VerticalAlignment="Center" />

                                                        <Button x:Name="RecordHotkeyButton"
                                                                Grid.Column="1"
                                                                Width="168"
                                                                Style="{StaticResource KeyFieldStyle}"
                                                                Tag="Record"
                                                                ToolTip="单击后按下新的组合键"
                                                                AutomationProperties.AutomationId="settings.hotkey.record"
                                                                AutomationProperties.Name="修改录屏快捷键"
                                                                Click="HotkeyButton_Click">
                                                            <TextBlock x:Name="RecordHotkeyValueText"
                                                                       FontFamily="Consolas, Segoe UI"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource TextPrimaryBrush}" />
                                                        </Button>
                                                    </Grid>
                                                </Border>

                                                <Rectangle Style="{StaticResource RowDividerStyle}" />

                                                <Border Padding="16,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Text="贴图"
                                                                   Style="{StaticResource SettingTitleStyle}"
                                                                   VerticalAlignment="Center" />

                                                        <Button x:Name="PinHotkeyButton"
                                                                Grid.Column="1"
                                                                Width="168"
                                                                Style="{StaticResource KeyFieldStyle}"
                                                                Tag="Pin"
                                                                ToolTip="单击后按下新的组合键"
                                                                AutomationProperties.AutomationId="settings.hotkey.pin"
                                                                AutomationProperties.Name="修改贴图快捷键"
                                                                Click="HotkeyButton_Click">
                                                            <TextBlock x:Name="PinHotkeyValueText"
                                                                       FontFamily="Consolas, Segoe UI"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource TextPrimaryBrush}" />
                                                        </Button>
                                                    </Grid>
                                                </Border>

                                                <Rectangle Style="{StaticResource RowDividerStyle}" />

                                                <TextBlock x:Name="HotkeyHint"
                                                           Text="单击按键区域后按下新的组合键；单键会独占该键，Esc 取消"
                                                           FontSize="10.5"
                                                           Foreground="{StaticResource TextTertiaryBrush}"
                                                           TextWrapping="Wrap"
                                                           Margin="16,10,16,14" />
                                            </StackPanel>
                                        </Border>

                                        <TextBlock Text="启动"
                                                   Style="{StaticResource GroupLabelStyle}"
                                                   Margin="4,20,0,8" />
                                        <Border Style="{StaticResource CardStyle}">
                                            <Border Padding="16,14">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel VerticalAlignment="Center"
                                                                Margin="0,0,18,0">
                                                        <TextBlock Text="登录时启动"
                                                                   Style="{StaticResource SettingTitleStyle}" />
                                                        <TextBlock Text="进入桌面后静默运行，仅驻留托盘"
                                                                   Style="{StaticResource SettingDescStyle}" />
                                                    </StackPanel>

                                                    <ToggleButton x:Name="AutoStartToggle"
                                                                  Grid.Column="1"
                                                                  VerticalAlignment="Center"
                                                                  Style="{StaticResource ToggleSwitchStyle}"
                                                                  ToolTip="开启登录时启动"
                                                                  AutomationProperties.Name="登录时启动" />
                                                </Grid>
                                            </Border>
                                        </Border>

                                        <TextBlock Text="外观"
                                                   Style="{StaticResource GroupLabelStyle}"
                                                   Margin="4,20,0,8" />
                                        <Border Style="{StaticResource CardStyle}">
                                            <Border Padding="16,14">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel VerticalAlignment="Center"
                                                                Margin="0,0,18,0">
                                                        <TextBlock Text="光圈尺寸"
                                                                   Style="{StaticResource SettingTitleStyle}" />
                                                        <TextBlock Text="以光标为中心展开，默认中号"
                                                                   Style="{StaticResource SettingDescStyle}" />
                                                    </StackPanel>

                                                    <Border Grid.Column="1"
                                                            Background="#FFF0F0F3"
                                                            BorderBrush="#FFE2E2E7"
                                                            BorderThickness="1"
                                                            CornerRadius="8"
                                                            Padding="2"
                                                            VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <RadioButton x:Name="SmallSizeRadio"
                                                                         GroupName="MenuSize"
                                                                         Content="小"
                                                                         Width="44"
                                                                         Style="{StaticResource SegmentOptionStyle}"
                                                                         AutomationProperties.Name="小尺寸光圈"
                                                                         Checked="MenuSizeRadio_Checked" />
                                                            <RadioButton x:Name="MediumSizeRadio"
                                                                         GroupName="MenuSize"
                                                                         Content="中"
                                                                         Width="44"
                                                                         Style="{StaticResource SegmentOptionStyle}"
                                                                         AutomationProperties.Name="中尺寸光圈"
                                                                         Checked="MenuSizeRadio_Checked" />
                                                            <RadioButton x:Name="LargeSizeRadio"
                                                                         GroupName="MenuSize"
                                                                         Content="大"
                                                                         Width="44"
                                                                         Style="{StaticResource SegmentOptionStyle}"
                                                                         AutomationProperties.Name="大尺寸光圈"
                                                                         Checked="MenuSizeRadio_Checked" />
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>

                            <!-- 截图与贴图 -->
                            <Grid x:Name="CapturePane" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <StackPanel Margin="30,26,30,0"
                                            Background="Transparent"
                                            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                                    <TextBlock Text="截图与贴图" Style="{StaticResource PaneTitleStyle}" />
                                    <TextBlock Text="图片格式与剪贴板行为"
                                               Style="{StaticResource PaneSubtitleStyle}" />
                                </StackPanel>

                                <ScrollViewer Grid.Row="1"
                                              Margin="30,20,30,0"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              Focusable="False">
                                    <StackPanel Margin="0,0,4,20">
                                        <TextBlock Text="图片" Style="{StaticResource GroupLabelStyle}" />
                                        <Border Style="{StaticResource CardStyle}">
                                            <Border Padding="16,14">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel VerticalAlignment="Center"
                                                                Margin="0,0,18,0">
                                                        <TextBlock Text="保存格式"
                                                                   Style="{StaticResource SettingTitleStyle}" />
                                                        <TextBlock Text="截图与另存贴图时使用；PNG 无损，JPG 体积更小"
                                                                   Style="{StaticResource SettingDescStyle}" />
                                                    </StackPanel>

                                                    <Border Grid.Column="1"
                                                            Background="#FFF0F0F3"
                                                            BorderBrush="#FFE2E2E7"
                                                            BorderThickness="1"
                                                            CornerRadius="8"
                                                            Padding="2"
                                                            VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <RadioButton x:Name="PngRadio"
                                                                         GroupName="ScreenshotFormat"
                                                                         Content="PNG"
                                                                         Width="62"
                                                                         Style="{StaticResource SegmentOptionStyle}"
                                                                         Checked="FormatRadio_Checked" />
                                                            <RadioButton x:Name="JpegRadio"
                                                                         GroupName="ScreenshotFormat"
                                                                         Content="JPG"
                                                                         Width="62"
                                                                         Style="{StaticResource SegmentOptionStyle}"
                                                                         Checked="FormatRadio_Checked" />
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </Border>

                                        <TextBlock Text="贴图"
                                                   Style="{StaticResource GroupLabelStyle}"
                                                   Margin="4,20,0,8" />
                                        <Border Style="{StaticResource CardStyle}">
                                            <Border Padding="16,14">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel VerticalAlignment="Center"
                                                                Margin="0,0,18,0">
                                                        <TextBlock Text="图片文件转为图像"
                                                                   Style="{StaticResource SettingTitleStyle}" />
                                                        <TextBlock Text="复制的图片文件以图像贴出；关闭后显示文件路径"
                                                                   Style="{StaticResource SettingDescStyle}" />
                                                    </StackPanel>

                                                    <ToggleButton x:Name="ConvertFilePathsToImagesToggle"
                                                                  Grid.Column="1"
                                                                  VerticalAlignment="Center"
                                                                  Style="{StaticResource ToggleSwitchStyle}"
                                                                  ToolTip="将图片文件转换为图像"
                                                                  AutomationProperties.AutomationId="settings.convertFilePathsToImages"
                                                                  AutomationProperties.Name="将文件路径转为图片" />
                                                </Grid>
                                            </Border>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>

                            <!-- 录屏 -->
                            <Grid x:Name="RecordingPane" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <StackPanel Margin="30,26,30,0"
                                            Background="Transparent"
                                            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                                    <TextBlock Text="录屏" Style="{StaticResource PaneTitleStyle}" />
                                    <TextBlock Text="录制文件的保存位置"
                                               Style="{StaticResource PaneSubtitleStyle}" />
                                </StackPanel>

                                <ScrollViewer Grid.Row="1"
                                              Margin="30,20,30,0"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              Focusable="False">
                                    <StackPanel Margin="0,0,4,20">
                                        <TextBlock Text="存储" Style="{StaticResource GroupLabelStyle}" />
                                        <Border Style="{StaticResource CardStyle}">
                                            <StackPanel Margin="16,14">
                                                <TextBlock Text="保存位置"
                                                           Style="{StaticResource SettingTitleStyle}" />
                                                <TextBlock Text="可使用完整路径；留空时保存到系统视频文件夹"
                                                           Style="{StaticResource SettingDescStyle}" />

                                                <Grid Margin="0,12,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBox x:Name="RecordingDirectoryBox"
                                                             Style="{StaticResource FieldTextBoxStyle}"
                                                             AutomationProperties.Name="录屏保存文件夹"
                                                             TextChanged="RecordingDirectoryBox_TextChanged" />

                                                    <Button Grid.Column="1"
                                                            Content="浏览…"
                                                            Width="78"
                                                            Height="34"
                                                            Margin="8,0,0,0"
                                                            Style="{StaticResource KeyFieldStyle}"
                                                            FontSize="11.5"
                                                            Click="BrowseButton_Click" />
                                                </Grid>

                                                <TextBlock x:Name="RecordingDirectoryHint"
                                                           FontSize="10.5"
                                                           Foreground="{StaticResource TextTertiaryBrush}"
                                                           TextWrapping="Wrap"
                                                           Margin="2,8,0,0" />
                                            </StackPanel>
                                        </Border>

                                        <TextBlock Text="当前仅录制画面，不含麦克风或系统声音。"
                                                   FontSize="10.5"
                                                   Foreground="{StaticResource TextTertiaryBrush}"
                                                   Margin="4,12,0,0" />
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>

                            <!-- 关于 -->
                            <Grid x:Name="AboutPane" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <StackPanel Margin="30,26,30,0"
                                            Background="Transparent"
                                            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                                    <TextBlock Text="关于" Style="{StaticResource PaneTitleStyle}" />
                                    <TextBlock Text="版本与本地数据"
                                               Style="{StaticResource PaneSubtitleStyle}" />
                                </StackPanel>

                                <ScrollViewer Grid.Row="1"
                                              Margin="30,20,30,0"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              Focusable="False">
                                    <StackPanel Margin="0,0,4,24">
                                        <StackPanel HorizontalAlignment="Center" Margin="0,10,0,24">
                                            <Grid Width="56" Height="56" HorizontalAlignment="Center">
                                                <Ellipse Stroke="#22000000" StrokeThickness="1" />
                                                <Ellipse Margin="8" Stroke="{StaticResource AccentBrush}" StrokeThickness="2.4" />
                                                <Ellipse Width="9"
                                                         Height="9"
                                                         Fill="#FFF5B963"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center" />
                                            </Grid>
                                            <TextBlock Text="HaloCap 光圈"
                                                       FontSize="18"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,14,0,0" />
                                            <TextBlock x:Name="VersionText"
                                                       FontSize="10.5"
                                                       Foreground="{StaticResource TextTertiaryBrush}"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,4,0,0" />
                                            <TextBlock Text="截图、文字识别、录屏与贴图，全部在本机完成。"
                                                       FontSize="11.5"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       TextAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       Width="340"
                                                       Margin="0,12,0,0" />
                                        </StackPanel>

                                        <Border Style="{StaticResource CardStyle}">
                                            <StackPanel>
                                                <Border Padding="16,13">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                                            <TextBlock Text="隐私"
                                                                       Style="{StaticResource SettingTitleStyle}" />
                                                            <TextBlock Text="无账号、无遥测、无网络请求"
                                                                       Style="{StaticResource SettingDescStyle}" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="完全离线"
                                                                   FontSize="10.5"
                                                                   Foreground="{StaticResource AccentBrush}"
                                                                   VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>

                                                <Rectangle Style="{StaticResource RowDividerStyle}" />

                                                <Border Padding="16,13">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="设置文件"
                                                                   Style="{StaticResource SettingTitleStyle}"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="%APPDATA%\HaloCap\settings.json"
                                                                   FontFamily="Consolas, Segoe UI"
                                                                   FontSize="10"
                                                                   Foreground="{StaticResource TextTertiaryBrush}"
                                                                   VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>

                                                <Rectangle Style="{StaticResource RowDividerStyle}" />

                                                <Border Padding="16,13">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="日志"
                                                                   Style="{StaticResource SettingTitleStyle}"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="%APPDATA%\HaloCap\logs"
                                                                   FontFamily="Consolas, Segoe UI"
                                                                   FontSize="10"
                                                                   Foreground="{StaticResource TextTertiaryBrush}"
                                                                   VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>

                                                <Rectangle Style="{StaticResource RowDividerStyle}" />

                                                <Border Padding="16,13">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="快捷键"
                                                                   Style="{StaticResource SettingTitleStyle}"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="在「通用」中查看与修改"
                                                                   FontSize="10.5"
                                                                   Foreground="{StaticResource TextTertiaryBrush}"
                                                                   VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Grid>

                        <!-- 保存栏 -->
                        <Border x:Name="SaveBar"
                                Grid.Row="1"
                                BorderBrush="{StaticResource SettingsHairlineBrush}"
                                BorderThickness="0,1,0,0"
                                Background="#FFFAFAFC"
                                Padding="30,12,30,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Grid VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock x:Name="FooterHint"
                                               Text="更改在保存后生效"
                                               FontSize="10.5"
                                               Foreground="{StaticResource TextTertiaryBrush}"
                                               VerticalAlignment="Center" />
                                    <Border x:Name="ErrorBanner"
                                            Visibility="Collapsed"
                                            Background="#FFFFEDEB"
                                            BorderBrush="#FFF4C7C2"
                                            BorderThickness="1"
                                            CornerRadius="7"
                                            Padding="10,6"
                                            HorizontalAlignment="Left">
                                        <TextBlock x:Name="ErrorText"
                                                   Foreground="#FFB3261E"
                                                   FontSize="10.5"
                                                   TextWrapping="Wrap"
                                                   MaxWidth="400" />
                                    </Border>
                                </Grid>

                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Button Content="取消"
                                            Width="72"
                                            Style="{StaticResource FooterGhostButtonStyle}"
                                            Click="CancelButton_Click" />
                                    <Button x:Name="SaveButton"
                                            Content="保存"
                                            Width="84"
                                            Style="{StaticResource FooterPrimaryButtonStyle}"
                                            Margin="8,0,0,0"
                                            IsDefault="True"
                                            Click="SaveButton_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
