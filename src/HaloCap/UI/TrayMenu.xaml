<ContextMenu x:Class="HaloCap.UI.TrayMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="252"
             Placement="MousePoint"
             HasDropShadow="True"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Display"
             FontFamily="Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI">
    <ContextMenu.Resources>
        <SolidColorBrush x:Key="TrayTextPrimaryBrush" Color="#FF1D1D1F" />
        <SolidColorBrush x:Key="TrayTextSecondaryBrush" Color="#FF6E6E73" />
        <SolidColorBrush x:Key="TrayTextTertiaryBrush" Color="#FF8E8E93" />
        <SolidColorBrush x:Key="TrayHairlineBrush" Color="#14000000" />
        <SolidColorBrush x:Key="TrayAccentBrush" Color="#FF007AFF" />

        <Style x:Key="TrayMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource TrayTextPrimaryBrush}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Host"
                                Background="Transparent"
                                CornerRadius="7"
                                Padding="8,6"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ContentPresenter x:Name="IconPresenter"
                                                  ContentSource="Icon"
                                                  Width="16"
                                                  Height="16"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center" />

                                <Path x:Name="CheckGlyph"
                                      Width="14"
                                      Height="14"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center"
                                      Data="M3 8.5 6.2 11.7 12.8 4.6"
                                      Stroke="{StaticResource TrayAccentBrush}"
                                      StrokeThickness="1.7"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Visibility="Collapsed" />

                                <ContentPresenter Grid.Column="1"
                                                  ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  VerticalAlignment="Center"
                                                  Margin="9,0,16,0" />

                                <TextBlock Grid.Column="2"
                                           Text="{TemplateBinding InputGestureText}"
                                           Foreground="{StaticResource TrayTextTertiaryBrush}"
                                           FontSize="10.5"
                                           VerticalAlignment="Center"
                                           Margin="0,0,2,0" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Host" Property="Background" Value="#FFF0F5FC" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Host" Property="Background" Value="#FFE6EFFB" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible" />
                                <Setter TargetName="IconPresenter" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.36" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TrayMenuSeparatorStyle" TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="{StaticResource TrayHairlineBrush}" Margin="8,4" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ContextMenu.Resources>

    <ContextMenu.Template>
        <ControlTemplate TargetType="ContextMenu">
            <Border Background="#FCFFFFFF"
                    BorderBrush="#25000000"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="14,12,14,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid Width="22" Height="22" VerticalAlignment="Center">
                            <Ellipse Stroke="#22000000" StrokeThickness="1" />
                            <Ellipse Margin="3.5" Stroke="{StaticResource TrayAccentBrush}" StrokeThickness="1.6" />
                            <Ellipse Width="3.5"
                                     Height="3.5"
                                     Fill="#FFF5B963"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center" />
                        </Grid>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="9,0,0,0">
                            <TextBlock Text="HaloCap"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TrayTextPrimaryBrush}" />
                            <TextBlock Text="光圈"
                                       FontSize="10"
                                       Foreground="{StaticResource TrayTextTertiaryBrush}"
                                       Margin="6,1,0,0" />
                        </StackPanel>

                        <TextBlock Grid.Column="2"
                                   Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                   FontSize="10"
                                   Foreground="{StaticResource TrayTextTertiaryBrush}"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <Rectangle Grid.Row="1" Height="1" Fill="{StaticResource TrayHairlineBrush}" Margin="10,0" />

                    <StackPanel Grid.Row="2"
                                IsItemsHost="True"
                                Margin="6,5"
                                KeyboardNavigation.DirectionalNavigation="Cycle" />

                    <Rectangle Grid.Row="3" Height="1" Fill="{StaticResource TrayHairlineBrush}" Margin="10,0" />

                    <Grid Grid.Row="4" Margin="14,7,14,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="本地处理 · 无网络请求"
                                   FontSize="9.5"
                                   Foreground="{StaticResource TrayTextTertiaryBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="Esc 关闭"
                                   FontSize="9.5"
                                   Foreground="#FFB0B0B5"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Grid>
            </Border>
        </ControlTemplate>
    </ContextMenu.Template>
</ContextMenu>
